{
  "$defs": {
    "ArchiveSourcePage": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "url",
        "sha256"
      ],
      "title": "ArchiveSourcePage",
      "type": "object"
    },
    "InventoryEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,119}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "published_at": {
          "format": "date",
          "title": "Published At",
          "type": "string"
        },
        "citation": {
          "title": "Citation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "published_at",
        "citation"
      ],
      "title": "InventoryEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "since": {
      "format": "date",
      "title": "Since",
      "type": "string"
    },
    "until": {
      "format": "date",
      "title": "Until",
      "type": "string"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/InventoryEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "source_pages": {
      "items": {
        "$ref": "#/$defs/ArchiveSourcePage"
      },
      "minItems": 1,
      "title": "Source Pages",
      "type": "array"
    },
    "note": {
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "since",
    "until",
    "total",
    "entries",
    "source_pages",
    "note"
  ],
  "title": "ArchiveInventory",
  "type": "object"
}
