---
import '../styles/global.css';
import '../styles/responsive.css';
import Icon from '../components/Icon.astro';
import { defaultDataset, repoUrl } from '../lib/data';
import type { Dataset } from '../lib/types';
interface Props { title: string; description?: string; dataset?: Dataset; active?: string }
const { title, description = 'Vom Wahlversprechen zum Gesetz: Politrace macht politische Zusagen und ihre Belege öffentlich nachvollziehbar.', dataset = defaultDataset(), active = '' } = Astro.props;
const root = `/${dataset}`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2458e5" />
    {dataset === 'demo' && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Politrace</title>
  </head>
  <body>
    <a href="#content" class="skip-link">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="header-inner container">
        <a class="brand" href="/" aria-label="Politrace Startseite"><img src="/favicon.svg" alt="" width="34" height="34" /><span>poli<span class="brand-light">trace</span><span class="beta">POC</span></span></a>
        <nav class="main-nav" aria-label="Hauptnavigation">
          <a class:list={[{ active: active === 'parties' }]} href={`${root}/parteien/`} aria-current={active === 'parties' ? 'page' : undefined}><Icon name="parties" size={18} />Parteien</a>
          <a class:list={[{ active: active === 'activity' }]} href={`${root}/aktivitaet/`} aria-current={active === 'activity' ? 'page' : undefined}><Icon name="activity" size={18} />Aktivität</a>
        </nav>
        <div class="header-actions"><a href="/methodik/" class="quiet-link">So funktioniert’s</a><a href={repoUrl} class="icon-button" aria-label="Quellcode auf GitHub"><Icon name="github" /></a></div>
      </div>
    </header>
    <div class:list={['dataset-banner', dataset]}>
      <div class="container banner-inner">
        <span><strong>{dataset === 'demo' ? 'DEMO' : 'LIVE-DATEN'}</strong>{dataset === 'demo' ? 'Fiktive Programme, Gesetze und Bewertungen. Keine Aussagen über die tatsächliche Politik.' : 'Amtliche Quellen · KI-Verknüpfungen sind Vorschläge, bis Menschen sie geprüft haben.'}</span>
        <a href={dataset === 'demo' ? '/live/aktivitaet/' : '/demo/parteien/'}>{dataset === 'demo' ? 'Echte Gesetzesdaten' : 'Zur Produktdemo'}<Icon name="arrow" size={14} /></a>
      </div>
    </div>
    <main id="content" class="container"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-main"><div><a class="brand footer-brand" href="/">politrace<span class="blue-dot"></span></a><p>Politik hinterlässt Spuren.<br />Wir machen sie nachvollziehbar.</p></div><div class="footer-links"><a href="/methodik/">Methodik & Grenzen</a><a href="/daten/">Daten & API</a><a href="/quellen/">Quellen & Abdeckung</a><a href={`${repoUrl}/blob/main/CONTRIBUTING.md`}>Mitwirken</a><a href="/datenschutz/">Datenschutz</a></div></div>
      <div class="container footer-bottom"><span>Ein offenes Projekt. Kein Parteiranking.</span><span>Öffentlich · Quellenbasiert · Korrigierbar <Icon name="branch" size={14} /></span></div>
    </footer>
  </body>
</html>
