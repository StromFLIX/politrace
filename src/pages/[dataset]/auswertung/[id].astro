---
import Layout from '../../../layouts/Layout.astro';
import Stats from '../../../components/Stats.astro';
import { datasets, getData } from '../../../lib/data';
import { experiments, experimentTotals } from '../../../lib/experiments';
export function getStaticPaths() {
  return datasets.flatMap(dataset => experiments(dataset).map(report => ({
    params: { dataset, id: report.program_id }, props: { report, data: getData(dataset) },
  })));
}
const { report, data } = Astro.props;
const program = data.programs.find(p => p.id === report.program_id)!;
const totals = experimentTotals(report);
const criteria = new Map(data.criteria.map(c => [c.id, c]));
const laws = new Map(data.laws.map(law => [law.id, law]));
const audits = new Map(report.laws.map(audit => [audit.law_id, audit]));
const money = (value?: number) => value == null ? 'unbekannt' : `$${value.toFixed(4)}`;
---
<Layout title="Programmweite Auswertung" active="parties" dataset={data.dataset}>
  <div class="page-heading"><div class="breadcrumbs"><a href={`/${data.dataset}/parteien/${program.party_id}/`}>Partei</a><span> / Auswertung</span></div>
    <div class="eyebrow">Automatisierte Vorschläge · nicht redaktionell bestätigt</div>
    <h1>Ein Programm. Alle ausgewählten Gesetze.</h1><p>{program.title}</p>
    <a class="button" href={`/api/v1/${data.dataset}/experiments/${report.program_id}.json`}>Vollständiges Prüfprotokoll als JSON</a>
  </div>
  <Stats items={[
    { value: `${report.processed_leaves}/${report.total_leaves}`, label: 'Absätze verarbeitet', detail: 'Keine Garantie semantischer Vollständigkeit', icon: 'file' },
    { value: totals.grouped, label: 'Vorgeschlagene Gruppen', detail: `${totals.criteria} ursprüngliche Kriterien bleiben erhalten`, icon: 'branch' },
    { value: `${totals.lawsCompleted}/${report.law_ids.length}`, label: 'Gesetze durchsucht', detail: `${totals.candidatePairs} Kandidatenpaare geprüft`, icon: 'search' },
    { value: money(report.cost.reported_cost_usd), label: 'Gemeldete Modellkosten', detail: `Gesamtrahmen ${money(report.cost.max_usd)}`, icon: 'activity' },
  ]} />
  <section class="evidence-box" aria-labelledby="limits-title"><h2 id="limits-title">Was diese Übersicht zeigt — und was nicht</h2>
    <p>Gleichwertige Zusagen werden als <strong>ungeprüfte Gruppen</strong> zusammengefasst; alle ursprünglichen Kriterien und Fundstellen bleiben erreichbar. Beträge, Fristen, Zielgruppen oder Prüfaufträge dürfen nicht zu unterschiedlichen Umsetzungszusagen verschmolzen werden. Die bisherigen Erfüllungsstatistiken ändern sich dadurch nicht.</p>
    <p>Die Suche kombiniert das ganze Gesetz, überlappende Textabschnitte und eine Rückwärtssuche von jedem Kriterium. {totals.omitted.toLocaleString('de-DE')} nicht ausgewählte Paare bleiben <strong>unbekannt</strong>. Die Trefferquote der Suche ist noch nicht unabhängig gemessen; „alle Gesetze durchsucht“ bedeutet nicht „jede mögliche Verbindung erkannt“.</p>
    <p>{totals.links} bestehende oder vorgeschlagene Verbindungen · {totals.missingContext} Fälle mit fehlendem Rechtskontext · {totals.unsupported} ohne ausreichend belegte Verbindung. Keine automatische Erfüllung, keine erfundenen Abstimmungen.</p>
    <p>Modell: {report.cost.model ?? 'siehe Protokoll'} · Gegenprüfung: {report.cost.review_model ?? 'siehe Protokoll'}. Kosten umfassen diesen fortgesetzten Lauf einschließlich Fehlversuchen, nicht frühere Pilotläufe. Gemeldete Kosten: {money(report.cost.reported_cost_usd)}; einschließlich offener Reservierungen: {money(report.cost.budget_exposure_usd)}. {report.cost.cost_accounting_complete ? 'Für alle abgeschlossenen Aufrufe liegt eine Kostenmeldung vor.' : 'Ein Teil der Kosten ist noch unbekannt und wird konservativ reserviert.'}</p>
    <p><a href={`/${data.dataset}/programme/${program.id}/`}>Programm und Transkriptionshinweise lesen</a> · <a href="/methodik/">Methodik und Prüfregeln</a></p>
  </section>
  <nav class="tabs" aria-label="Auswertungsabschnitte"><a href="#gruppen">Zusagengruppen</a><a href="#gesetze">Gesetze & Lücken</a></nav>
  <section id="gruppen"><div class="section-heading"><div><h2>Zusagen ohne versteckte Zusammenführungen</h2><p>{totals.combined} Gruppen mit mehreren Fundstellen. Alle Gruppen sind Vorschläge, keine neue bestätigte Kennzahl.</p></div></div>
    <label for="group-search">Zusagengruppen durchsuchen</label><input id="group-search" type="search" placeholder="Zum Beispiel Mietpreisbremse …" class="group-search" />
    <p id="group-count" aria-live="polite">{report.groups.length} Gruppen</p>
    <div class="group-list">{report.groups.map(group => {
      const canonical = criteria.get(group.canonical_criterion_id)!;
      const members = group.member_ids.map(id => criteria.get(id)!);
      const impacts = data.impacts.filter(i => group.member_ids.includes(i.criterion_id));
      const reasons = report.deduplication.filter(d => d.decision.equivalent && group.member_ids.includes(d.left_id) && group.member_ids.includes(d.right_id));
      return <article class="evidence-box commitment-group" id={group.id} data-group data-search={members.map(c => `${c.title} ${c.test} ${c.reference.quote}`).join(' ').toLocaleLowerCase('de-DE')}>
        <h3><a href={`/${data.dataset}/kriterien/${canonical.id}/`}>{canonical.title}</a></h3><p>{canonical.test}</p>
        <p class="group-meta">Ungeprüfte Gruppe · {members.length} Quellkriterien · {impacts.length} Belegvorschläge · <a href={`#${group.id}`}>Direktlink</a></p>
        <details><summary>Fundstellen, Kriterien & Verbindungen anzeigen</summary>
          <ul>{members.map(c => <li><a href={`/${data.dataset}/kriterien/${c.id}/`}>{c.title}</a> — <a href={`/${data.dataset}/programme/${c.program_id}/#${c.leaf_id}`}>PDF-Seite {c.reference.page}, Quellabsatz</a></li>)}</ul>
          {reasons.map(d => <p><strong>Vorgeschlagene Gleichwertigkeit:</strong> {d.decision.rationale}</p>)}
          {impacts.length ? <ul>{impacts.map(i => <li><a href={`/${data.dataset}/gesetze/${i.law_id}/#${i.id}`}>{laws.get(i.law_id)?.title}</a> · {i.score > 0 ? '+' : ''}{i.score} · {i.verification === 'needs_review' ? 'Modellwiderspruch — Prüfung offen' : 'Modellgegenprüfung bestanden — menschliche Prüfung offen'}</li>)}</ul> : <p>Noch keine belegte Verbindung. Das ist keine Aussage über Erfüllung oder Nichterfüllung.</p>}
        </details>
      </article>;
    })}</div>
  </section>
  <section class="section-block" id="gesetze"><h2>Jedes Gesetz hat einen sichtbaren Prüfstand</h2><p>Bundesgesetzblatt I und II, Veröffentlichung im ausgewählten Zeitfenster ab 25. März 2025. Veröffentlichungsdatum ist nicht Abstimmungsdatum oder Inkrafttreten. Noch ausstehende Gesetze werden nicht als geprüft gezählt.</p>
    <div class="table-scroll"><table class="data-table"><caption class="sr-only">Gesetz, geprüfte Kandidaten, vorgeschlagene Verbindungen und fehlender Rechtskontext</caption><thead><tr><th>Gesetz</th><th>Prüfstand</th><th>Kandidaten</th><th>Verbindungen</th><th>Kontext fehlt</th></tr></thead><tbody>{report.law_ids.map(id => {
      const audit = audits.get(id);
      return <tr><td><a href={`/${data.dataset}/gesetze/${id}/`}>{laws.get(id)?.title ?? id}</a></td><td>{audit?.status === 'completed' ? 'Kandidaten geprüft' : audit?.status === 'needs_ocr' ? 'Text unvollständig' : 'Ausstehend'}</td><td>{audit?.pairs.length ?? '—'}</td><td>{audit?.pairs.filter(p => p.impact_id).length ?? '—'}</td><td>{audit?.pairs.filter(p => p.disposition === 'missing_context').length ?? '—'}</td></tr>;
    })}</tbody></table></div>
  </section>
</Layout>
<style>
  .group-search { display:block; width:100%; padding:12px; border:1px solid var(--border); border-radius:8px; margin:8px 0; font:inherit; }
  .commitment-group { scroll-margin-top:100px; }
  .commitment-group details { margin-top:12px; }
  .commitment-group summary { cursor:pointer; }
  .commitment-group li { margin:10px 0; }
  .group-meta { font-size:0.85rem; }
  .data-table td:first-child { min-width:240px; max-width:540px; }
</style>
<script>
  const search = document.querySelector<HTMLInputElement>('#group-search');
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  function filter() {
    const terms = (search?.value ?? '').toLocaleLowerCase('de-DE').split(/\s+/).filter(Boolean);
    let count = 0;
    for (const group of groups) {
      group.hidden = !terms.every(t => group.dataset.search?.includes(t));
      if (!group.hidden) count++;
    }
    const counter = document.querySelector('#group-count');
    if (counter) counter.textContent = `${count} Gruppen`;
  }
  search?.addEventListener('input', filter);
  function reveal() {
    const group = groups.find(g => '#' + g.id === location.hash);
    if (group) { if (search) search.value = ''; filter(); group.querySelector('details')?.setAttribute('open', ''); }
  }
  window.addEventListener('hashchange', reveal);
  reveal();
</script>
