---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import Stats from '../../../components/Stats.astro';
import FilterBar from '../../../components/FilterBar.astro';
import CriterionRow from '../../../components/CriterionRow.astro';
import PeriodSwitch from '../../../components/PeriodSwitch.astro';
import ExtractionStatus from '../../../components/ExtractionStatus.astro';
import { datasets, getData, metrics, formatDate, repoUrl } from '../../../lib/data';
export function getStaticPaths() { return datasets.flatMap(dataset => { const data = getData(dataset); return data.parties.map(party => ({ params: { dataset, party: party.id }, props: { party, data } })); }); }
const { party, data } = Astro.props;
const programs = data.programs.filter(p => p.party_id === party.id && p.review.status !== 'rejected').sort((a, b) => b.election_year - a.election_year || b.published_at.localeCompare(a.published_at));
const years = [...new Set(programs.map(p => p.election_year))];
---
<Layout title={party.short_name} active="parties" dataset={data.dataset}>
  <div class="page-heading"><div class="breadcrumbs"><a href={`/${data.dataset}/parteien/`}>Parteien</a><Icon name="chevron" size={12} /><span>{party.short_name}</span></div><div class="page-heading-row"><div class="party-title"><span class="party-logo large" style={`--party:${party.color}`}>{party.short_name}</span><div><div class="eyebrow">Die Partei im Blick</div><h1>{party.short_name}</h1><p class="party-subtitle">{party.name}</p></div></div><div class="page-actions"><a class="button" href={`/api/v1/${data.dataset}/parties/${party.id}.json`}><Icon name="code" size={15} /> Daten als JSON</a>{years.length > 0 && <PeriodSwitch years={years} selected={years[0]} />}</div></div></div>
  <nav class="tabs" aria-label="Parteiabschnitte"><a href="#kriterien" class="selected">Kriterien & Belege</a><a href="#programme">Wahlprogramme</a><a href="#verlauf">Frühere Zeiträume</a></nav>
  {!programs.length && <div class="empty-state"><Icon name="file" size={30} /><h2>Noch kein Wahlprogramm importiert</h2><p>Für {party.short_name} liegen in diesem Datensatz noch keine prüfbaren Kriterien vor. Das ist keine Aussage über die Partei. Ein Programm kann über die GitHub-Pipeline hinzugefügt werden.</p><a class="button primary" href={`${repoUrl}/blob/main/docs/pipelines.md`}>Programm hinzufügen <Icon name="arrow" size={14} /></a></div>}
  {years.map((year, index) => {
    const selected = programs.filter(p => p.election_year === year);
    const criteria = data.criteria.filter(c => selected.some(p => p.id === c.program_id));
    const stats = metrics(criteria, data.impacts, selected);
    return <section data-period-panel={year} hidden={index !== 0}>
      {selected.map(program => <ExtractionStatus program={program} criteria={criteria} />)}
      <Stats items={[
        { value: stats.total, label: 'Prüfbare Kriterien', detail: `Programmjahr ${year}`, icon: 'check' },
        { value: stats.fulfilled, label: 'Nachweislich erfüllt', detail: `Von insgesamt ${stats.total} Kriterien`, icon: 'shield' },
        { value: stats.partial, label: 'Teilweise erfüllt', detail: `${stats.contradicted} Kriterien widersprochen`, icon: 'activity' },
        { value: stats.coverage === null ? '—' : `${stats.coverage}%`, label: 'Belegabdeckung', detail: `${stats.unknown} Kriterien noch offen`, icon: 'link' },
      ]} />
      <div class="two-column"><section data-filter-root id={index === 0 ? 'kriterien' : undefined}><div class="section-heading"><div><h2>Woran wir die Zusagen messen</h2><p>Konkrete Tests statt politischer Schlagworte.</p></div></div><FilterBar /><div class="result-count" aria-live="polite" data-result-count>{criteria.length} Einträge</div><div class="criterion-list">{criteria.map(c => <CriterionRow criterion={c} data={data} />)}</div><div class="empty-state" data-no-results hidden={criteria.length > 0}><Icon name="search" size={24} /><h2>Keine passenden Kriterien</h2><p>Ändere den Suchbegriff oder setze die Filter auf „Alle“.</p></div></section>
      <aside><div class="side-card"><Icon name="file" size={22} /><h2 style="margin-top:12px">Das Programm als Datenprodukt</h2><p>Vom PDF zum vollständigen Textbaum. Jeder Absatz bleibt mit seiner Quelle verbunden.</p>{selected.map(program => <a class="text-link" href={`/${data.dataset}/programme/${program.id}/`}>Programm {year} lesen <Icon name="arrow" size={14} /></a>)}</div><div class="side-card"><h2>Was sagt diese Zahl?</h2><p>„Erfüllt“ bedeutet: Ein konkreter Test wurde redaktionell anhand verlinkter Gesetzesbelege bewertet. Positive KI-Verknüpfungen allein reichen dafür nicht.</p><a href="/methodik/" class="text-link">Methodik & Grenzen <Icon name="arrow" size={14} /></a></div></aside></div>
    </section>;
  })}
  {programs.length > 0 && <><section class="section-block" id="programme"><div class="section-heading"><h2>Die Originalspur</h2><a href={`/api/v1/${data.dataset}/programs.json`} class="text-link">Programm-API <Icon name="code" size={15} /></a></div>{programs.map(p => <div class="evidence-box"><div class="impact-heading"><div><h3>{p.title}</h3><p>Veröffentlicht {formatDate(p.published_at)} · {p.leaves.length} Absätze · {data.dataset === 'demo' ? 'Fiktive Quelle' : p.source.publisher}</p></div><a class="button" href={`/${data.dataset}/programme/${p.id}/`}>Textbaum öffnen <Icon name="branch" size={15} /></a></div></div>)}</section>
  <section class="section-block" id="verlauf"><h2>Transparenz über die Zeit</h2><div class="table-scroll"><table class="data-table"><caption class="sr-only">Kennzahlen nach Wahlprogramm, nicht als Zeitreihe desselben Versprechens</caption><thead><tr><th>Programm</th><th>Kriterien</th><th>Erfüllt</th><th>Teilweise</th><th>Offen</th><th>Belegabdeckung</th></tr></thead><tbody>{programs.map(p => { const m = metrics(data.criteria.filter(c => c.program_id === p.id), data.impacts, [p]); return <tr><td><a href={`/${data.dataset}/programme/${p.id}/`}>Bundestagswahl {p.election_year}</a></td><td>{m.total}</td><td>{m.fulfilled}</td><td>{m.partial}</td><td>{m.unknown}</td><td>{m.coverage === null ? '—' : `${m.coverage}%`}</td></tr>; })}</tbody></table></div><p class="history-note">Unterschiedliche Programme enthalten unterschiedliche Kriterien. Diese Momentaufnahme ist keine vergleichbare Performance-Rangliste; frühere Bewertungsstände bleiben in der Git-Historie erhalten.</p></section></>}
</Layout>
