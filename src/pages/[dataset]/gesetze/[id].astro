---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import ImpactCard from '../../../components/ImpactCard.astro';
import Votes from '../../../components/Votes.astro';
import LawText from '../../../components/LawText.astro';
import { datasets, getData, formatDate, editUrl } from '../../../lib/data';
export function getStaticPaths() { return datasets.flatMap(dataset => { const data = getData(dataset); return data.laws.map(law => ({ params: { dataset, id: law.id }, props: { data, law } })); }); }
const { data, law } = Astro.props;
const matchingLabels: Record<string, string> = { pending: 'Noch nicht ausgeführt', no_programs: 'Keine passenden Programme vorhanden', no_candidates: 'Keine Kandidaten gefunden', proposed: 'Vorschläge erstellt', no_supported_links: 'Keine belegten Verbindungen', needs_ocr: 'OCR erforderlich' };
const impacts = data.impacts.filter(i => i.law_id === law.id);
---
<style>
  /* Long official URLs/table rows must not widen the mobile grid or its tap coordinates. */
  .two-column > div, .two-column > aside { min-width: 0; }
</style>
<Layout title={law.title} active="activity" dataset={data.dataset}><div class="page-heading"><div class="breadcrumbs"><a href={`/${data.dataset}/aktivitaet/`}>Aktivität</a><Icon name="chevron" size={12} /><span>Gesetz</span></div><div class="eyebrow">{data.dataset === 'demo' ? 'Fiktives Beispiel' : 'Amtliche Verkündung'} · {formatDate(law.published_at)}</div><h1>{law.title}</h1><p>{law.summary}</p><div class="page-actions" style="margin-top:20px"><a class="button" href={`/api/v1/${data.dataset}/laws/${law.id}.json`}><Icon name="code" size={15} /> Gesetz als JSON</a>{law.markdown_path && <a class="button" href={`/api/v1/${data.dataset}/laws/${law.id}/source.md`}><Icon name="download" size={15} /> Gesetzestext als Markdown</a>}</div></div><div class="two-column"><div><Votes votes={data.votes.filter(v => v.law_id === law.id)} dataset={data.dataset} /><section class="section-block"><h2>Verbindungen zu Wahlversprechen</h2>{impacts.map(impact => <ImpactCard impact={impact} data={data} direction="criterion" />)}{!impacts.length && <div class="empty-state"><Icon name="link" size={25} /><h2>Noch keine Verknüpfungen</h2><p>Die Programme fehlen noch oder es gibt keine hinreichend belegte Zuordnung. „Keine Verbindung gefunden“ ist keine Aussage über die tatsächliche politische Wirkung.</p></div>}</section><section class="section-block"><h2>Die gesetzliche Textspur</h2><p class="notice">Extrahierter Originaltext, kein konsolidierter Gesetzesstand. Verweise auf andere Gesetze und konkrete Geltungsdaten müssen gesondert geprüft werden.</p><LawText law={law} />{law.text_status === 'needs_ocr' && <p>Dieses PDF benötigt eine geprüfte OCR-Transkription. Es werden keine Auswirkungen aus seinem Titel abgeleitet.</p>}</section></div><aside><div class="side-card"><h2>Amtliche Quelle</h2><dl><dt>Fundstelle</dt><dd>{law.citation}</dd><dt>Verkündung</dt><dd>{formatDate(law.published_at)}</dd><dt>Abgerufen</dt><dd>{formatDate(law.source.retrieved_at)}</dd><dt>Herausgeber</dt><dd>{law.source.publisher}</dd><dt>PDF-Prüfsumme (SHA-256)</dt><dd class="record-id">{law.source.sha256 || 'Fiktive Quelle, kein Original-PDF'}</dd></dl>{data.dataset === 'live' && <a class="text-link" href={law.source.url}>Amtliche Veröffentlichung <Icon name="arrow" size={13} /></a>}{law.pdf_url && <a class="text-link" href={law.pdf_url}>Original-PDF <Icon name="download" size={13} /></a>}<a class="text-link" href={editUrl(data.dataset, 'laws', law.id)}>Metadaten korrigieren <Icon name="github" size={13} /></a></div><div class="side-card"><h2>Was wurde abgeglichen?</h2><dl><dt>Matching-Status</dt><dd>{matchingLabels[law.matching.status]}</dd><dt>Ausgewählte Kriterien</dt><dd>{law.matching.candidate_ids.length} von {law.matching.eligible_count}</dd><dt>Nicht ausgewählt (Wirkung unbekannt)</dt><dd>{law.matching.omitted_count}</dd></dl><p>Suchverfahren: deutsche Wortstämme und Themenbegriffe. Dies ist noch keine vollständige semantische Prüfung aller möglichen Zusammenhänge.</p></div></aside></div></Layout>
