---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import ImpactCard from '../../../components/ImpactCard.astro';
import Votes from '../../../components/Votes.astro';
import DocumentReader from '../../../components/DocumentReader.astro';
import { readingEdition } from '../../../lib/readings';
import { datasets, getData, formatDate, editUrl } from '../../../lib/data';
export function getStaticPaths() { return datasets.flatMap(dataset => { const data = getData(dataset); return data.laws.map(law => ({ params: { dataset, id: law.id }, props: { data, law } })); }); }
const { data, law } = Astro.props;
const matchingLabels: Record<string, string> = { pending: 'Noch nicht vollständig ausgeführt', no_programs: 'Keine passenden Programme vorhanden', no_candidates: 'Keine Kandidaten gefunden', proposed: 'Vorschläge erstellt', no_supported_links: 'Keine belegten Verbindungen', needs_ocr: 'OCR erforderlich' };
const impacts = data.impacts.filter(i => i.law_id === law.id);
const reading = readingEdition(law.id);
---
<Layout title={law.title} active="activity" dataset={data.dataset}>
  <header class="page-heading">
    <div class="breadcrumbs"><a href="/live/aktivitaet/">Aktivität</a><Icon name="chevron" size={12} /><span>Gesetz</span></div>
    <div class="eyebrow">Amtliche Verkündung · {formatDate(law.published_at)}</div>
    <h1>{law.title}</h1><p>{law.summary}</p>
    <div class="page-actions" style="margin-top:20px"><a class="button primary" href="#gesetz-lesen">{reading ? 'Gesetz lesen ↓' : 'Quellen & Lesestatus ↓'}</a>{reading && <a class="button" href={`/api/v1/live/readings/${law.id}/source.md`}><Icon name="download" size={15} /> Lesefassung als Markdown</a>}<a class="button" href={`/api/v1/live/laws/${law.id}.json`}><Icon name="code" size={15} /> Gesetz als JSON</a></div>
  </header>
  <div class="two-column">
    <div>
      <Votes votes={data.votes.filter(v => v.law_id === law.id)} dataset={data.dataset} />
      <section class="section-block"><h2>Verbindungen zu Wahlversprechen</h2>
        {impacts.map(impact => <ImpactCard impact={impact} data={data} direction="criterion" />)}
        {!impacts.length && <div class="empty-state"><Icon name="link" size={25} /><h2>Noch keine Verknüpfungen</h2><p>Noch keine hinreichend belegte Zuordnung veröffentlicht. „Keine Verbindung gefunden“ ist keine Aussage über die tatsächliche politische Wirkung.</p><a href="/fortschritt/">Stand der Prüfung ansehen →</a></div>}
      </section>
    </div>
    <aside>
      <div class="side-card"><h2>Amtliche Quelle</h2>
        <dl><dt>Fundstelle</dt><dd>{law.citation}</dd><dt>Verkündung</dt><dd>{formatDate(law.published_at)}</dd><dt>Abgerufen</dt><dd>{formatDate(law.source.retrieved_at)}</dd><dt>Herausgeber</dt><dd>{law.source.publisher}</dd><dt>PDF-Prüfsumme (SHA-256)</dt><dd class="record-id">{law.source.sha256 || 'Noch nicht erfasst'}</dd></dl>
        <a class="text-link" href={law.source.url}>Amtliche Veröffentlichung <Icon name="arrow" size={13} /></a>
        {law.pdf_url && <a class="text-link" href={law.pdf_url}>Original-PDF <Icon name="download" size={13} /></a>}
        <a class="text-link" href={editUrl(data.dataset, 'laws', law.id)}>Metadaten korrigieren <Icon name="github" size={13} /></a>
      </div>
      <div class="side-card"><h2>Was wurde abgeglichen?</h2>
        <dl><dt>Matching-Status</dt><dd>{matchingLabels[law.matching.status]}</dd><dt>Ausgewählte Kriterien</dt><dd>{law.matching.candidate_ids.length} von {law.matching.eligible_count}</dd><dt>Nicht ausgewählt (Wirkung unbekannt)</dt><dd>{law.matching.omitted_count}</dd></dl>
        <p>Die Vorauswahl kann relevante Zusammenhänge übersehen. Nicht ausgewählte Kriterien gelten nicht als unbeeinflusst.</p><a class="text-link" href="/fortschritt/">Abdeckung aller Programme →</a>
      </div>
    </aside>
  </div>
  <section id="gesetz-lesen" class="section-block">
    <p class="notice">Veröffentlichter Gesetzestext, kein konsolidierter Rechtsstand. Verweise auf andere Gesetze, Ausnahmen und konkrete Geltungsdaten müssen gesondert geprüft werden.</p>
    <DocumentReader documentId={law.id} collection="laws" sourceUrl={law.pdf_url ?? law.source.url} edition={reading} evidence={law.passages} />
    {law.text_status === 'needs_ocr' && <p>Die Belegextraktion ist noch unvollständig. Eine Lesefassung allein ersetzt keine geprüften Zitate; Auswirkungen werden nicht aus dem Titel abgeleitet.</p>}
  </section>
</Layout>
<style>
  .two-column > div, .two-column > aside { min-width: 0; }
  #gesetz-lesen { scroll-margin-top: 110px; }
</style>
