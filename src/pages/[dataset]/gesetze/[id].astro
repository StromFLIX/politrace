---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import ImpactCard from '../../../components/ImpactCard.astro';
import Votes from '../../../components/Votes.astro';
import VotingComparisons from '../../../components/VotingComparisons.astro';
import { publicImpact } from '../../../lib/metrics';
import DocumentReader from '../../../components/DocumentReader.astro';
import { readingEdition } from '../../../lib/readings';
import { datasets, getData, formatDate, editUrl } from '../../../lib/data';
export function getStaticPaths() { return datasets.flatMap(dataset => { const data = getData(dataset); return data.laws.map(law => ({ params: { dataset, id: law.id }, props: { data, law } })); }); }
const { data, law } = Astro.props;
const impacts = data.impacts.filter(i => i.law_id === law.id && publicImpact(i));
const reading = readingEdition(law.id);
---
<Layout title={law.title} active="activity" dataset={data.dataset}>
  <header class="page-heading">
    <div class="breadcrumbs"><a href="/live/aktivitaet/">Aktivität</a><Icon name="chevron" size={12} /><span>Gesetz</span></div>
    <div class="eyebrow">Amtliche Verkündung · {formatDate(law.published_at)}</div>
    <h1>{law.title}</h1><p>{law.summary}</p>
    <div class="page-actions" style="margin-top:20px"><a class="button" href="#abstimmungen">Abstimmungen ↓</a><a class="button primary" href="#gesetz-lesen">{reading ? 'Gesetz lesen ↓' : 'Quellen & Lesestatus ↓'}</a>{reading && <a class="button" href={`/api/v1/live/readings/${law.id}/source.md`}><Icon name="download" size={15} /> Lesefassung als Markdown</a>}<a class="button" href={`/api/v1/live/laws/${law.id}.json`}><Icon name="code" size={15} /> Gesetz als JSON</a></div>
  </header>
  <div class="two-column">
    <div>
      <Votes votes={data.votes.filter(v => v.law_id === law.id)} dataset={data.dataset} coverage={data.votingCoverage?.items.find(row => row.law_id === law.id)} />
      <VotingComparisons data={data} lawId={law.id} />
      <section class="section-block"><h2>Verbindungen zu Wahlversprechen</h2>
        {impacts.map(impact => <ImpactCard impact={impact} data={data} direction="criterion" />)}
        {!impacts.length && <div class="empty-state"><Icon name="link" size={25} /><h2>Noch keine Verknüpfungen</h2><p>Zu diesem Gesetz sind noch keine Verbindungen zu Wahlversprechen veröffentlicht.</p></div>}
      </section>
    </div>
    <aside>
      <div class="side-card"><h2>Amtliche Quelle</h2>
        <dl><dt>Fundstelle</dt><dd>{law.citation}</dd><dt>Verkündung</dt><dd>{formatDate(law.published_at)}</dd><dt>Abgerufen</dt><dd>{formatDate(law.source.retrieved_at)}</dd><dt>Herausgeber</dt><dd>{law.source.publisher}</dd><dt>PDF-Prüfsumme (SHA-256)</dt><dd class="record-id">{law.source.sha256 || 'Noch nicht erfasst'}</dd></dl>
        <a class="text-link" href={law.source.url}>Amtliche Veröffentlichung <Icon name="arrow" size={13} /></a>
        {law.pdf_url && <a class="text-link" href={law.pdf_url}>Original-PDF <Icon name="download" size={13} /></a>}
        <a class="text-link" href={editUrl(data.dataset, 'laws', law.id)}>Metadaten korrigieren <Icon name="github" size={13} /></a>
      </div>
    </aside>
  </div>
  <section id="gesetz-lesen" class="section-block">
    <p class="method-note">Gesetzestext in der Fassung der amtlichen Verkündung · {law.citation}</p>
    <DocumentReader documentId={law.id} collection="laws" sourceUrl={law.pdf_url ?? law.source.url} edition={reading} evidence={law.passages} />
    {law.text_status === 'needs_ocr' && <p>Die durchsuchbare Textfassung wird vorbereitet. Das Original-PDF ist bereits verfügbar.</p>}
  </section>
</Layout>
<style>
  .two-column > div, .two-column > aside { min-width: 0; }
  #gesetz-lesen { scroll-margin-top: 110px; }
</style>
