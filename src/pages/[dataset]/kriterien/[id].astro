---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import ImpactCard from '../../../components/ImpactCard.astro';
import { readingPageHref } from '../../../lib/document-anchors';
import { datasets, getData, topics, statusLabels, reviewLabels, formatDate, editUrl, mdUrl, sectionPath } from '../../../lib/data';
export function getStaticPaths() { return datasets.flatMap(dataset => { const data = getData(dataset); return data.criteria.map(criterion => ({ params: { dataset, id: criterion.id }, props: { data, criterion } })); }); }
const { data, criterion: c } = Astro.props;
const program = data.programs.find(p => p.id === c.program_id)!;
const party = data.parties.find(p => p.id === c.party_id)!;
const impacts = data.impacts.filter(i => i.criterion_id === c.id).sort((a, b) => data.laws.find(l => l.id === b.law_id)!.published_at.localeCompare(data.laws.find(l => l.id === a.law_id)!.published_at));
const path = sectionPath(program.tree, c.leaf_id);
---
<Layout title={c.title} active="parties" dataset={data.dataset}>
  <div class="page-heading"><div class="breadcrumbs"><a href={`/${data.dataset}/parteien/`}>Parteien</a><Icon name="chevron" size={12} /><a href={`/${data.dataset}/parteien/${party.id}/`}>{party.short_name}</a><Icon name="chevron" size={12} /><span>Kriterium</span></div><div class="eyebrow"><span class="record-id">{c.id.toUpperCase()}</span></div><h1>{c.title}</h1><p>{c.description}</p><div class="activity-top" style="margin-top:18px"><span class:list={['status', c.assessment.status]}>{statusLabels[c.assessment.status]}</span><span class:list={['status', c.review.status]}>{reviewLabels[c.review.status]}</span>{c.tags.map(t => <span class="tag">{topics[t]}</span>)}</div></div>
  <div class="two-column"><div><section class="test-box"><div class="eyebrow"><Icon name="check" size={15} /> Der Akzeptanztest</div><p>{c.test}</p></section>
    {c.review.note && <p class="notice" data-review-note><strong>Hinweis zur Prüfung:</strong> {c.review.note}</p>}
    <section class="evidence-box"><h2>Die Zusage im Wahlprogramm</h2><div class="source-chain">{path.map((section, index) => <><span>{section}</span>{index !== path.length - 1 && <Icon name="chevron" size={10} />}</>)}</div><blockquote>{c.reference.quote}</blockquote><div class="evidence-footer"><span>PDF-Seite {c.reference.page} · Markdown Zeilen {c.reference.line_start}–{c.reference.line_end}</span><a href={readingPageHref('programs', program.id, c.reference.page)} class="text-link">Im Programm lesen <Icon name="file" size={13} /></a><a href={mdUrl(program.markdown_path, c.reference.line_start)} class="text-link">Markdown-Referenz <Icon name="arrow" size={13} /></a></div></section>
    <section class="evidence-box"><h2>Erfüllungsbewertung: {statusLabels[c.assessment.status]}</h2><p>{c.assessment.rationale}</p>{c.assessment.assessed_at && <div class="evidence-footer"><span>{formatDate(c.assessment.assessed_at)} · {c.assessment.reviewer}</span><span>{c.assessment.evidence_ids.length} verknüpfte Belege</span></div>}<p class="method-note"><Icon name="info" size={14} />Diese Bewertung wird redaktionell gepflegt. Sie ist nicht die Summe der Wirkungswerte einzelner Gesetze.</p></section>
    <div class="section-heading"><div><h2>Was Gesetze daran verändern</h2><p>{impacts.length} Verknüpfung{impacts.length === 1 ? '' : 'en'} · auch Vorschläge und verworfene Zuordnungen bleiben sichtbar.</p></div></div>
    {impacts.map(impact => <ImpactCard impact={impact} data={data} />)}{!impacts.length && <div class="empty-state"><Icon name="link" size={26} /><h2>Die Spur ist noch offen</h2><p>Es gibt noch keine dokumentierte Gesetzesverknüpfung. Das ist weder ein Beleg für noch gegen die Erfüllung.</p></div>}
  </div><aside><div class="side-card"><h2>Jede Zuordnung ist korrigierbar.</h2><p>Das Kriterium ist zu ungenau? Ein Beleg fehlt? Schlage eine Änderung an diesem Datensatz vor. Diskussion und Review bleiben öffentlich.</p><a class="text-link" href={editUrl(data.dataset, 'criteria', c.id)}>Kriterium auf GitHub bearbeiten <Icon name="github" size={14} /></a></div><div class="side-card"><h2>Das Kriterium als Datenprodukt</h2><dl><dt>Partei</dt><dd>{party.short_name}</dd><dt>Wahlprogramm</dt><dd>{program.election_year}</dd><dt>Frist aus der Quelle</dt><dd>{c.deadline ? formatDate(c.deadline) : 'Keine gesondert erfasste Frist'}</dd><dt>Stabile ID</dt><dd class="record-id">{c.id}</dd><dt>Vergleichszeitraum</dt><dd>{formatDate(program.period_start)} bis {program.period_end ? `${formatDate(program.period_end)} (exklusiv)` : 'offen'}</dd></dl><a class="text-link" href={`/api/v1/${data.dataset}/criteria/${c.id}.json`}>JSON herunterladen <Icon name="download" size={14} /></a></div></aside></div>
</Layout>
