---
import Layout from '../../../layouts/Layout.astro';
import CriteriaBrowser from '../../../components/CriteriaBrowser.astro';
import { datasets, getData } from '../../../lib/data';
export function getStaticPaths() { return datasets.map(dataset => ({ params: { dataset }, props: { data: getData(dataset) } })); }
const { data } = Astro.props;
---
<Layout title="Alle Kriterien" active="parties" dataset={data.dataset}>
  <div class="page-heading"><div class="eyebrow">Die Zusagen, im Detail</div><h1>Was müsste sich ändern?</h1><p>Alle prüfbaren Kriterien, nach Themen geordnet und parteiübergreifend durchsuchbar. Jedes führt zurück zum Absatz im Wahlprogramm.</p></div>
  <section style="margin-bottom:55px"><CriteriaBrowser id="alle-kriterien" criteria={data.criteria} data={data} parties={data.parties} /></section>
</Layout>
