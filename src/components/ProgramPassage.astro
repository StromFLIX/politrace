---
import Icon from './Icon.astro';
import { mdUrl } from '../lib/data';
import { isLayoutLeaf, readingHtml, searchText } from '../lib/program-reader';
import type { Criterion, Leaf, Program } from '../lib/types';
interface Props { leaf: Leaf; program: Program; criteria: Criterion[]; number: number; sections: string[] }
const { leaf, program, criteria, number, sections } = Astro.props;
const audit = program.criteria_extraction?.find(a => a.leaf_id === leaf.id);
const pdfPage = program.pdf_url ? `${program.pdf_url.split('#')[0]}#page=${leaf.reference.page}` : null;
const searchable = searchText([leaf.text, ...sections, ...criteria.flatMap(c => [c.title, c.test])].join(' '));
const layoutOnly = criteria.length === 0 && isLayoutLeaf(leaf, program, sections);
---
<article class="program-passage" id={leaf.id} data-reader-passage data-search={searchable} data-has-criteria={criteria.length > 0 ? 'true' : 'false'}>
  <div class="passage-location"><a href={`#${leaf.id}`} aria-label={`Link zu Absatz ${number}, PDF-Seite ${leaf.reference.page}`}>S. {leaf.reference.page}<span aria-hidden="true"> · </span><span>Absatz {String(number).padStart(3, '0')}</span></a></div>
  {layoutOnly
    ? <details class="passage-layout" data-reader-layout><summary>Überschrift / Seitenelement anzeigen <Icon name="down" size={13} /></summary><div class="reader-prose" set:html={readingHtml(leaf.text)} /></details>
    : <div class="reader-prose" set:html={readingHtml(leaf.text)} />}
  {criteria.length > 0 && <details class="passage-criteria" data-reader-criteria>
    <summary><Icon name="check" size={15} /><span>{criteria.length} {criteria.length === 1 ? 'Kriterium' : 'Kriterien'} aus diesem Absatz</span><Icon name="down" size={14} /></summary>
    <div class="passage-criteria-list">
      <p>Abgeleitete Tests, nicht die Erfüllung der Zusagen. Den Prüfstatus findest du beim jeweiligen Kriterium.</p>
      {criteria.map(criterion => <a href={`/${program.dataset}/kriterien/${criterion.id}/`}><span>{criterion.title}</span><Icon name="arrow" size={15} /></a>)}
    </div>
  </details>}
  <details class="passage-source" id={`${leaf.id}-source`}>
    <summary><Icon name="link" size={13} /> Quelle & exaktes Zitat <Icon name="down" size={12} /></summary>
    <div class="passage-source-body">
      <div class="passage-source-links">
        {pdfPage && <a href={pdfPage}>PDF-Seite {leaf.reference.page} <Icon name="arrow" size={12} /></a>}
        <a href={mdUrl(program.markdown_path, leaf.reference.line_start)}>Markdown L{leaf.reference.line_start}–L{leaf.reference.line_end} <Icon name="github" size={12} /></a>
        <a href={`#${leaf.id}`}>Absatz verlinken <Icon name="link" size={12} /></a>
      </div>
      <p>Unveränderte extrahierte Textspur, einschließlich PDF-Umbrüchen und Markdown. Sie ist die Grundlage der Zitate; die Lesefassung oben ändert nur die Darstellung.</p>
      <pre data-exact-source>{leaf.text}</pre>
      {criteria.length === 0 && <p class="passage-audit"><strong>Kriterienprüfung:</strong> {audit?.abstention_reason || 'Dieser Absatz wurde noch nicht für Kriterien ausgewertet. Das bedeutet nicht, dass er keine Zusage enthält.'}</p>}
    </div>
  </details>
</article>
