---
import { formatDate } from '../lib/data';
import { voteTotals } from '../lib/metrics';
import Icon from './Icon.astro';
import type { Vote, Dataset } from '../lib/types';
interface Props { votes: Vote[]; dataset: Dataset }
const { votes } = Astro.props;
const reviewed = votes.filter(v => v.review.status === 'reviewed');
---
<section class="evidence-box"><h2>Wer hat wie abgestimmt?</h2>
{reviewed.length === 0 ? <><p>Keine belegten Abstimmungsdaten hinterlegt.</p><p class="method-note"><Icon name="info" size={15} />Das Bundesgesetzblatt dokumentiert die Verkündung, nicht das Abstimmungsverhalten. Wir leiten Stimmen weder aus Koalitionen noch aus einer Gesetzeswirkung ab.</p></> : reviewed.map(vote => {
  const t = voteTotals(vote.groups);
  return <div><p>{vote.motion}</p><p style="font-size:10px;margin-top:7px">{formatDate(vote.date)} · {vote.type === 'roll_call' ? 'Namentliche Abstimmung' : 'Dokumentierter Fraktionsnachweis'}</p><div class="votes-bar" role="img" aria-label={`${t.yes} Ja, ${t.no} Nein, ${t.abstain} Enthaltungen, ${t.absent} nicht abgegeben`}><span class="vote-yes" style={`flex:${t.yes}`} /><span class="vote-no" style={`flex:${t.no}`} /><span class="vote-abstain" style={`flex:${t.abstain}`} /><span class="vote-absent" style={`flex:${t.absent}`} /></div><div class="legend" style="margin:10px 0 16px"><span><i style="--dot:#348a69" />{t.yes} Ja</span><span><i style="--dot:#c26b68" />{t.no} Nein</span><span><i style="--dot:#c1a457" />{t.abstain} Enthaltungen</span><span><i style="--dot:#c8d0da" />{t.absent} nicht abgegeben</span></div><div class="table-scroll"><table class="data-table"><caption class="sr-only">Stimmen nach Fraktion, einschließlich nicht abgegebener Stimmen</caption><thead><tr><th>Fraktion / Gruppe</th><th class="num">Ja</th><th class="num">Nein</th><th class="num">Enth.</th><th class="num">Nicht abg.</th></tr></thead><tbody>{vote.groups.map(g => <tr><td>{g.group}</td><td class="num">{g.yes}</td><td class="num">{g.no}</td><td class="num">{g.abstain}</td><td class="num">{g.absent}</td></tr>)}</tbody></table></div><div class="evidence-footer"><span>{vote.source.publisher}</span>{<a class="text-link" href={vote.source.url}>Amtlicher Abstimmungsnachweis <Icon name="arrow" size={13} /></a>}</div></div>;
})}
</section>
