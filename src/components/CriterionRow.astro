---
import { topics, statusLabels } from '../lib/data';
import Icon from './Icon.astro';
import { publicImpact } from '../lib/metrics';
import type { AssessmentStatus, Criterion, Data } from '../lib/types';
interface Props { criterion: Criterion; data: Data; status: AssessmentStatus; covered: boolean; hidden?: boolean }
const { criterion: c, data, status, covered, hidden = false } = Astro.props;
const party = data.parties.find(p => p.id === c.party_id)!;
const impacts = data.impacts.filter(i => i.criterion_id === c.id && publicImpact(i));
---
<a class="criterion-row" hidden={hidden} href={`/${data.dataset}/kriterien/${c.id}/`} data-filter-item data-search={`${c.id} ${c.title} ${c.description} ${c.test} ${c.keywords.join(' ')} ${c.tags.map(t => topics[t]).join(' ')} ${party.short_name}`} data-party={c.party_id} data-topic={c.tags.join(' ')} data-status={status} data-covered={covered ? 'true' : undefined}>
  <div class="criterion-row-top"><span class="record-id">{c.id.toUpperCase()}</span><span class:list={['status', status]}>{status === 'fulfilled' && <Icon name="check" size={11} />}{statusLabels[status]}</span></div>
  <h3>{c.title}</h3>
  <div class="criterion-row-meta"><span style={`color:${party.color}`}>{party.short_name}</span>{c.tags.map(tag => <span class="tag">{topics[tag]}</span>)}<span><Icon name="link" size={12} /> {impacts.length} Gesetzesbeleg{impacts.length === 1 ? '' : 'e'}</span></div>
</a>
