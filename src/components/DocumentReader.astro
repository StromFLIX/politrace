---
import { readingHtml } from '../lib/program-reader';
import { sourcePageAnchors } from '../lib/document-anchors';
import type { ReadingEdition } from '../lib/readings';
import type { Criterion, Leaf, TreeNode } from '../lib/types';
interface Props {
  documentId: string; collection: 'programs' | 'laws'; sourceUrl: string;
  edition: ReadingEdition | null; evidence: Leaf[]; criteria?: Criterion[]; tree?: TreeNode;
}
const { documentId, collection, sourceUrl, edition, evidence, criteria = [], tree } = Astro.props;
const pdfUrl = (edition?.retrieved_from ?? edition?.source_url ?? sourceUrl).split('#')[0];
const isMirror = !!edition?.retrieved_from && edition.retrieved_from !== edition.source_url;
const sourceAnchors = sourcePageAnchors(evidence, tree);
const titles = new Map(edition?.pages.map(page => [page.number, page.markdown.match(/^#{1,4}\s+(.+)$/m)?.[1]?.replace(/[*_]/g, '')]));
const outline = edition?.pages.flatMap(page => titles.get(page.number) ? [{ number: page.number, title: titles.get(page.number) }] : []) ?? [];
const byPage = new Map<number, Criterion[]>();
for (const criterion of criteria) {
  const page = criterion.reference.page;
  byPage.set(page, [...(byPage.get(page) ?? []), criterion]);
}
// A missing OCR page must never silently strand an existing citation.
if (edition && [...sourceAnchors.keys()].some(number => !edition.pages.some(page => page.number === number))) {
  throw new Error(`Reading edition ${documentId} is missing a cited PDF page`);
}
---
{edition ? <section class="document-reader" data-document-reader>
  <header class="document-intro">
    <div><span class="eyebrow">Lesefassung</span><h2>Das Dokument. Nicht sein PDF-Layout.</h2>
    <p>Lesbare Absätze, Überschriften und Tabellen. {edition.page_count} Originalseiten vollständig zugeordnet.</p></div>
    <a class="button" href={`/api/v1/live/readings/${documentId}/source.md`}>Lesefassung als Markdown ↓</a>
  </header>
  <p class="document-note">Automatische OCR, noch nicht redaktionell geprüft. Seitenhinweise zeigen mögliche Übertragungsfehler; das Original-PDF ist maßgeblich. Bestehende Belegzitate bleiben unverändert bei den Kriterien, Verknüpfungen und in der API erhalten. Die Lesefassung ordnet sie der jeweiligen PDF-Seite zu, nicht wortgenau einer neuen Textstelle.</p>
  {isMirror && <p class="document-note">Die Herausgeber-Datei war zeitweise nicht erreichbar. <a href={pdfUrl}>Die verlinkte Archivkopie</a> stimmt per SHA-256 bytegenau mit dem Original überein. <a href={edition.source_url}>Ursprüngliche Herausgeber-Adresse ↗</a></p>}
  <div class="document-grid">
    <aside class="document-sidebar">
      <details open class="document-navigation">
        <summary>Inhalt & Seiten</summary>
        <div class="document-controls" data-reading-controls hidden>
          <label for={`reading-search-${documentId}`}>In der Lesefassung suchen</label>
          <input id={`reading-search-${documentId}`} type="search" data-reading-search placeholder="Begriff im Dokument …" autocomplete="off" />
          {collection === 'programs' && <label class="document-criteria-filter"><input type="checkbox" data-reading-only-criteria /> Nur Seiten mit Kriterien</label>}
          <label for={`reading-page-${documentId}`}>PDF-Seite</label>
          <select id={`reading-page-${documentId}`} data-reading-select>{edition.pages.map(page => <option value={page.number}>Seite {page.number}</option>)}</select>
          <p data-reading-count role="status" aria-live="polite">{edition.page_count} Seiten</p>
          <button type="button" class="document-reset" data-reading-reset hidden>Filter zurücksetzen</button>
        </div>
        <nav aria-label="Inhalt der Lesefassung"><ol>{outline.map(item => <li><a href={`#reading-page-${item.number}`}><span>{item.title}</span><small>{item.number}</small></a></li>)}</ol></nav>
      </details>
    </aside>
    <div class="document-content">
      <div class="document-empty" data-reading-empty hidden><h3>Keine passende Textstelle gefunden.</h3><p>Versuche einen anderen Begriff oder zeige das ganze Dokument.</p><button type="button" class="button" data-reading-reset>Alle Seiten anzeigen</button></div>
      {edition.pages.map((page, index) => <details class="document-page" id={`reading-page-${page.number}`} data-reading-page data-page={page.number} data-has-criteria={byPage.has(page.number) ? 'true' : 'false'} open={index === 0}>
        <summary>
          {(sourceAnchors.get(page.number) ?? []).map(id => <span class="document-source-anchor" id={id} data-source-anchor aria-hidden="true" />)}
          <span class="document-page-number">Seite {page.number}</span><span class="document-page-topic">{titles.get(page.number) ?? 'Text fortsetzen'}</span><span class="document-page-toggle" aria-hidden="true">＋</span>
        </summary>
        <div class="document-page-body">
          <p class="document-citation-note" data-reading-citation hidden>Der bisherige Absatz- oder Kapitellink führt jetzt zur zugehörigen PDF-Seite in der Lesefassung. Die exakten Belegzitate bleiben unverändert in der <a href={`/api/v1/live/${collection}/${documentId}.json`}>Quellen-API</a> erhalten.</p>
          {page.warnings.length > 0 && <p class="document-warning" data-reading-warning>Übertragung prüfen: Auf dieser Seite wurden Unterschiede oder mögliche Layoutfehler erkannt. <a href={`${pdfUrl}#page=${page.number}`}>Mit dem PDF vergleichen ↗</a></p>}
          {page.markdown ? <div class="document-prose" set:html={readingHtml(page.markdown)} /> : <p class="document-blank">Diese Seite enthält keinen erkannten Fließtext.</p>}
          {byPage.has(page.number) && <details class="document-criteria" data-reading-criteria>
            <summary>{byPage.get(page.number)!.length} {byPage.get(page.number)!.length === 1 ? 'Kriterium' : 'Kriterien'} auf dieser Seite</summary>
            <div class="document-criteria-list"><p>Abgeleitete Tests, keine Erfüllungsbewertung. Das genaue Belegzitat und den Prüfstatus findest du beim Kriterium.</p>
              {byPage.get(page.number)!.map(criterion => <a href={`/live/kriterien/${criterion.id}/`} data-reading-criterion data-criterion-id={criterion.id} data-criterion-test={criterion.test}>{criterion.title}<span aria-hidden="true"> →</span></a>)}
            </div>
          </details>}
          <footer class="document-source-links"><a href={`${pdfUrl}#page=${page.number}`}>{isMirror ? 'Archivkopie' : 'Original-PDF'} · Seite {page.number} ↗</a><a href={`#reading-page-${page.number}`}>Diese Seite verlinken</a></footer>
          {page.corrections?.length ? <details class="document-furniture"><summary>Protokollierte Lesekorrektur · weiterhin ungeprüft</summary>{page.corrections.map(c => <p><del>{c.before}</del> → <ins>{c.after}</ins><br />{c.source_evidence}</p>)}</details> : null}
          {(page.header || page.footer) && <details class="document-furniture"><summary>Kopf- und Fußzeile der Quelle</summary><pre>{[page.header, page.footer].filter(Boolean).join('\n\n')}</pre></details>}
        </div>
      </details>)}
    </div>
  </div>
</section> : <section class="document-reader document-unavailable" data-document-unavailable>
  {[...sourceAnchors].map(([page, ids]) => <><span class="document-source-anchor" id={`reading-page-${page}`} aria-hidden="true" />{ids.map(id => <span class="document-source-anchor" id={id} data-source-anchor aria-hidden="true" />)}</>)}
  <h2>Lesefassung wird vorbereitet</h2><p>Für dieses Dokument ist noch keine vollständige OCR-Lesefassung verfügbar. Die Quelle und die bisherigen Belegzitate bleiben zugänglich; eine alte PDF-Textdarstellung wird hier nicht als Ersatz angezeigt.</p>
  <div class="document-source-links"><a href={pdfUrl}>Originalquelle öffnen ↗</a><a href={`/api/v1/live/${collection}/${documentId}.json`}>Quellenbelege als JSON</a><a href="/fortschritt/">Bearbeitungsstand ansehen →</a></div>
</section>}
<style>
  .document-reader { margin: 36px 0; min-width: 0; }
  .document-intro { display: flex; gap: 20px; justify-content: space-between; align-items: center; }
  .document-intro h2 { font-size: clamp(22px, 3vw, 30px); margin: 8px 0; letter-spacing: -.6px; }
  .document-intro p, .document-note { color: var(--muted); line-height: 1.7; }
  .document-note { font-size: 12px; border-left: 3px solid #d0dff9; padding: 10px 14px; margin: 22px 0 30px; background: #f7f9fd; }
  .document-grid { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 44px; }
  .document-sidebar { min-width: 0; }
  .document-navigation { position: sticky; top: 100px; max-height: calc(100vh - 130px); overflow-y: auto; scrollbar-width: thin; padding-right: 12px; }
  .document-navigation > summary { cursor: pointer; font-size: 13px; font-weight: 700; padding: 8px 0; }
  .document-controls { padding: 12px 0; }
  .document-controls label { display: block; font-size: 11px; font-weight: 600; margin: 12px 0 6px; }
  .document-controls input[type="search"], .document-controls select { width: 100%; max-width: 100%; border: 1px solid var(--border); border-radius: 7px; padding: 10px; background: white; font: inherit; font-size: 13px; }
  .document-controls .document-criteria-filter { display: flex; gap: 8px; align-items: center; line-height: 1.6; cursor: pointer; }
  .document-criteria-filter input { flex-shrink: 0; accent-color: var(--blue); }
  .document-controls p { font-size: 11px; margin-top: 10px; color: var(--muted); }
  .document-reset { border: 0; background: none; padding: 0; color: var(--blue); font: inherit; font-size: 11px; text-decoration: underline; cursor: pointer; }
  .document-navigation ol { list-style: none; padding: 0; margin: 12px 0; }
  .document-navigation li a { display: flex; justify-content: space-between; gap: 14px; padding: 8px 0; font-size: 11px; color: var(--muted); text-decoration: none; line-height: 1.6; }
  .document-navigation a:hover { color: var(--blue); }
  .document-navigation small { flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .document-content { min-width: 0; }
  .document-empty { padding: 24px; border: 1px dashed var(--border); border-radius: 8px; }
  .document-empty h3 { font-size: 18px; margin-bottom: 12px; }
  .document-empty p { margin-bottom: 18px; }
  .document-page { border-top: 1px solid var(--border); scroll-margin-top: 115px; }
  .document-page > summary { position: relative; display: flex; gap: 16px; align-items: center; padding: 16px 0; cursor: pointer; font-size: 12px; color: var(--muted); list-style: none; }
  .document-page > summary::-webkit-details-marker { display: none; }
  .document-page-number { flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .document-page-topic { flex: 1; font-weight: 600; color: var(--ink); }
  .document-page[open] > summary .document-page-toggle { transform: rotate(45deg); }
  .document-page:target > summary, .document-page:has(.document-source-anchor:target) > summary { background: #f3f7ff; box-shadow: -8px 0 0 #f3f7ff, -11px 0 0 #7297ff, 8px 0 0 #f3f7ff; }
  .document-source-anchor { position: absolute; top: 0; left: 0; width: 1px; height: 1px; pointer-events: none; scroll-margin-top: 115px; }
  .document-page-body { max-width: 72ch; padding: 20px 0 36px; }
  .document-prose { font-family: Georgia, 'Times New Roman', serif; font-size: 19px; line-height: 1.85; color: #263343; overflow-wrap: anywhere; }
  .document-prose :global(p) { margin: 0 0 1.25em; white-space: normal; color: inherit; }
  .document-prose :global(h6:first-child) { margin-top: 0; }
  .document-prose :global(h6) { font-family: inherit; font-size: 1.18em; line-height: 1.4; margin: 1.7em 0 .8em; font-weight: 700; }
  .document-prose :global(ul), .document-prose :global(ol) { padding-left: 1.5em; margin-bottom: 1.2em; }
  .document-prose :global(li) { margin: .55em 0; }
  .document-prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-family: sans-serif; font-size: 13px; }
  .document-prose :global(td), .document-prose :global(th) { border: 1px solid var(--border); padding: 9px; text-align: left; overflow-wrap: normal; word-break: normal; line-height: 1.6; }
  .document-prose :global(blockquote) { border-left: 2px solid var(--border); padding-left: 18px; margin: 18px 0; }
  .document-prose :global(pre) { white-space: pre-wrap; font-size: 13px; }
  .document-source-links { display: flex; flex-wrap: wrap; gap: 12px 24px; padding-top: 20px; font-size: 11px; }
  .document-source-links a { color: var(--blue); }
  .document-criteria { margin: 28px 0 0; border: 1px solid #dce6fa; border-radius: 7px; background: #f5f8ff; }
  .document-criteria > summary { padding: 12px 14px; font-size: 12px; font-weight: 600; color: var(--blue); cursor: pointer; }
  .document-criteria-list { padding: 0 14px; }
  .document-criteria-list p { font-size: 11px; padding: 0 0 10px; }
  .document-criteria-list a { display: block; border-top: 1px solid #dce6fa; font-size: 13px; padding: 12px 0; color: #294e94; line-height: 1.6; overflow-wrap: anywhere; }
  .document-criteria-list a:hover { text-decoration: underline; }
  .document-furniture { margin-top: 20px; color: var(--muted); font-size: 11px; }
  .document-furniture summary { cursor: pointer; }
  .document-furniture pre { white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; padding: 12px; background: #f8fafc; }
  .document-warning { font-size: 12px; padding: 12px 14px; background: #fff9ec; border-left: 3px solid #ccb26b; line-height: 1.6; margin-bottom: 20px; }
  .document-citation-note { font-size: 12px; margin: 0 0 20px; line-height: 1.7; color: var(--muted); }
  .document-blank { color: var(--muted); font-style: italic; }
  .document-unavailable { position: relative; padding: 24px; border: 1px solid var(--border); border-radius: 8px; }
  .document-unavailable h2 { margin-bottom: 12px; }
  @media (max-width: 900px) { .document-grid { grid-template-columns: 1fr; gap: 18px; } .document-navigation { position: static; max-height: 320px; padding-right: 0; } .document-intro { align-items: start; flex-direction: column; } .document-prose { font-size: 18px; line-height: 1.8; } .document-page-body { padding-top: 14px; } }
  @media print { .document-sidebar, .document-note, .document-source-links, .document-furniture, .document-criteria, .document-citation-note, .document-empty, .document-intro > a { display: none; } .document-grid { display: block; } .document-prose { font-size: 11pt; } .document-page { break-inside: auto; } }
</style>
<script>
  import { searchText } from '../lib/program-reader-search';
  for (const reader of document.querySelectorAll<HTMLElement>('[data-document-reader]')) {
    const pages = [...reader.querySelectorAll<HTMLDetailsElement>('[data-reading-page]')];
    const search = reader.querySelector<HTMLInputElement>('[data-reading-search]')!;
    const onlyCriteria = reader.querySelector<HTMLInputElement>('[data-reading-only-criteria]');
    const select = reader.querySelector<HTMLSelectElement>('[data-reading-select]')!;
    const count = reader.querySelector<HTMLElement>('[data-reading-count]')!;
    const empty = reader.querySelector<HTMLElement>('[data-reading-empty]')!;
    const reset = reader.querySelector<HTMLButtonElement>('.document-reset')!;
    const texts = new Map(pages.map(p => [p, searchText([
      p.querySelector('.document-prose')?.textContent ?? '',
      ...[...p.querySelectorAll<HTMLAnchorElement>('[data-reading-criterion]')].flatMap(c => [c.textContent ?? '', c.dataset.criterionTest ?? '']),
    ].join(' '))]));
    reader.querySelector<HTMLElement>('[data-reading-controls]')!.hidden = false;
    const nav = reader.querySelector<HTMLDetailsElement>('.document-navigation')!;
    const mobile = matchMedia('(max-width: 900px)');
    nav.open = !mobile.matches;
    mobile.addEventListener('change', () => { nav.open = !mobile.matches; });
    const states = new Map<HTMLDetailsElement, boolean>();
    function syncUrl() {
      const url = new URL(location.href);
      if (search.value) url.searchParams.set('q', search.value); else url.searchParams.delete('q');
      if (onlyCriteria?.checked) url.searchParams.set('criteria', '1'); else url.searchParams.delete('criteria');
      history.replaceState(null, '', url);
    }
    function filter(updateUrl = true) {
      const terms = searchText(search.value).split(' ').filter(Boolean);
      const active = terms.length > 0 || !!onlyCriteria?.checked;
      if (active && !states.size) for (const page of pages) states.set(page, page.open);
      let matches = 0;
      for (const page of pages) {
        page.hidden = !terms.every(term => texts.get(page)!.includes(term)) || (!!onlyCriteria?.checked && page.dataset.hasCriteria !== 'true');
        if (!page.hidden) { matches++; if (active) page.open = true; }
        if (!active && states.has(page)) page.open = states.get(page)!;
      }
      if (!active) states.clear();
      count.textContent = `${matches} von ${pages.length} Seiten`;
      empty.hidden = matches > 0;
      reset.hidden = !active;
      if (updateUrl) syncUrl();
    }
    function clearFilters() { search.value = ''; if (onlyCriteria) onlyCriteria.checked = false; filter(); }
    function restoreFilters() {
      const query = new URL(location.href).searchParams;
      search.value = query.get('q') ?? '';
      if (onlyCriteria) onlyCriteria.checked = query.get('criteria') === '1';
      filter(false);
    }
    function reveal() {
      for (const note of reader.querySelectorAll<HTMLElement>('[data-reading-citation]')) note.hidden = true;
      let id: string;
      try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      const target = document.getElementById(id);
      if (!target || !reader.contains(target)) return;
      const page = target.closest<HTMLDetailsElement>('[data-reading-page]');
      if (!page) return;
      clearFilters();
      page.open = true;
      select.value = page.dataset.page!;
      if (target.hasAttribute('data-source-anchor')) page.querySelector<HTMLElement>('[data-reading-citation]')!.hidden = false;
      if (mobile.matches) nav.open = false;
      const hash = location.hash;
      // Use the visible page heading, never a zero-sized compatibility anchor.
      const scroll = () => { if (location.hash === hash) page.scrollIntoView({ block: 'start' }); };
      requestAnimationFrame(scroll);
      void document.fonts.ready.then(scroll);
    }
    select.addEventListener('change', () => { location.hash = `reading-page-${select.value}`; reveal(); });
    search.addEventListener('input', () => filter());
    search.addEventListener('keydown', event => { if (event.key === 'Escape') clearFilters(); });
    onlyCriteria?.addEventListener('change', () => filter());
    for (const button of reader.querySelectorAll('[data-reading-reset]')) button.addEventListener('click', clearFilters);
    // Re-selecting the current page must reveal it even if search hid it meanwhile.
    for (const link of reader.querySelectorAll<HTMLAnchorElement>('a[href^="#reading-page-"]')) {
      link.addEventListener('click', () => { if (link.hash === location.hash) reveal(); });
    }
    window.addEventListener('hashchange', reveal);
    window.addEventListener('popstate', () => { restoreFilters(); reveal(); });
    restoreFilters(); reveal();
    const printState = new Map<HTMLDetailsElement, { open: boolean; hidden: boolean }>();
    let emptyBeforePrint = true;
    window.addEventListener('beforeprint', () => {
      if (printState.size) return;
      emptyBeforePrint = empty.hidden; empty.hidden = true;
      for (const p of pages) { printState.set(p, { open: p.open, hidden: p.hidden }); p.hidden = false; p.open = true; }
    });
    window.addEventListener('afterprint', () => {
      if (!printState.size) return;
      for (const [p, state] of printState) { p.hidden = state.hidden; p.open = state.open; }
      printState.clear(); empty.hidden = emptyBeforePrint;
    });
  }
</script>
