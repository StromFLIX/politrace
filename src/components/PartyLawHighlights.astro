---
import Icon from './Icon.astro';
import { formatDate, impactLabels } from '../lib/data';
import { formatPercentage, type PartyInsights } from '../lib/party-insights';
import type { Dataset } from '../lib/types';
interface Props { insights: PartyInsights; dataset: Dataset; year: number; active: boolean }
const { insights, dataset, year, active } = Astro.props;
const number = (value: number) => value.toLocaleString('de-DE');
const directionLabels = { supporting: 'Unterstützend', opposing: 'Gegenläufig', mixed: 'Gemischte Wirkung' };
const listId = `law-highlights-${year}`;
---
<section class="insight-card law-highlights" data-law-highlights data-period-anchor="gesetzeswirkung" id={active ? 'gesetzeswirkung' : undefined} aria-labelledby={`${listId}-heading`}>
  <div class="insight-card-heading"><div><div class="eyebrow">Die Gesetze dahinter</div><h2 id={`${listId}-heading`}>Welche Gesetze bewegen am meisten?</h2></div><span class="insight-unit">{number(insights.laws.total)} Gesetze · {number(insights.laws.evidence)} Belege</span></div>
  <p class="insight-description">Die größte Reichweite im ausgewählten Programm, gemessen an betroffenen Kriterien. Der Beitrag zur Belegabdeckung ist keine Änderung der Umsetzungsquote.</p>
  {insights.law_effects.length > 0 ? <>
    <div class="law-controls" data-law-controls hidden>
      <label>Wirkung <select data-law-direction aria-controls={listId}><option value="">Alle Wirkungen</option><option value="supporting">Mit Unterstützung</option><option value="opposing">Mit Gegenwirkung</option><option value="mixed">Mit gemischter Wirkung</option></select></label>
      <label>Sortierung <select data-law-order aria-controls={listId}><option value="reach">Meiste betroffene Kriterien</option><option value="coverage">Größter Abdeckungsbeitrag</option><option value="recent">Neueste zuerst</option></select></label>
    </div>
    <p class="law-result-count" data-law-count aria-live="polite">{number(insights.laws.total)} Gesetze</p>
    <ol class="law-highlight-list" id={listId}>
      {insights.law_effects.map((law, index) => <li class="law-highlight" id={`law-highlight-${year}-${law.id}`} data-law-item data-id={law.id} data-affected={law.affected} data-new={law.newly_covered} data-date={law.published_at} data-supporting={law.supporting} data-opposing={law.opposing} data-direction={law.direction}>
        <div class="law-highlight-main">
          <span class="law-rank" data-law-rank aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div class="law-highlight-content">
            <div class="law-highlight-meta"><time datetime={law.published_at}>{formatDate(law.published_at)}</time><span>{law.citation}</span><span class:list={['law-direction', law.direction]}>{directionLabels[law.direction]}</span></div>
            <h3><a href={`/${dataset}/gesetze/${law.id}/`}>{law.title}<Icon name="arrow" size={14} /></a></h3>
            <div class="law-effect-counts"><strong>{number(law.affected)} betroffene Kriterien</strong>{law.supporting > 0 && <span class="effect-supporting">{number(law.supporting)} unterstützt</span>}{law.opposing > 0 && <span class="effect-opposing">{number(law.opposing)} mit Gegenwirkung</span>}{law.mixed > 0 && <span class="effect-mixed">{number(law.mixed)} gemischt</span>}</div>
          </div>
          <div class="law-contribution"><strong>{law.newly_covered ? '+' : ''}{formatPercentage(law.coverage_points).replace(' %', '')} <abbr title="Prozentpunkte">PP</abbr></strong><span>Belegabdeckung</span><small>{number(law.newly_covered)} alleinige Erstbelege</small>{law.shared_newly_covered > 0 && <small>+ {number(law.shared_newly_covered)} gemeinsame Erstbelege am selben Tag</small>}</div>
        </div>
        <details class="insight-details law-evidence-details"><summary>{number(law.evidence.length)} Belege & betroffene Kriterien ansehen</summary><ul class="law-criterion-evidence">{law.evidence.map(evidence => <li>
          <a href={`/${dataset}/kriterien/${evidence.criterion_id}/#${evidence.impact_id}`}>{evidence.criterion_title}<Icon name="arrow" size={12} /></a>
          <span class:list={['law-evidence-effect', { 'effect-opposing': evidence.score < 0, 'effect-supporting': evidence.score > 0, 'effect-mixed': evidence.score === 0 }]}>{impactLabels[evidence.score]}</span>
          <p>{evidence.rationale}</p>
          <a class="text-link" href={`/${dataset}/gesetze/${law.id}/#${evidence.impact_id}`}>Gesetz & Originalbeleg <Icon name="link" size={12} /></a>
        </li>)}</ul></details>
      </li>)}
    </ol>
    <p class="insight-empty" data-law-empty hidden>Keine akzeptierten Gesetzesbelege für diese Wirkung im ausgewählten Programm.</p>
    <button class="button law-more" type="button" data-law-more aria-controls={listId} hidden>Weitere Gesetze anzeigen</button>
    <p class="insight-footnote">Erstbelege zählen Kriterien, die zuvor keinen akzeptierten Gesetzesbeleg hatten. Gemeinsame Erstbelege am selben Veröffentlichungstag werden keinem Gesetz allein zugerechnet. Pluspunkte bedeuten mehr Belege, nicht automatisch mehr Umsetzung.</p>
  </> : <div class="insight-empty"><p><strong>Noch keine Gesetze mit akzeptierten Belegen</strong></p><p>Die Liste erscheint, sobald belastbare Verbindungen zum ausgewählten Programm vorliegen. Das ist keine Aussage über die Wirkung aller Gesetze.</p></div>}
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-law-highlights]').forEach(root => {
    const list = root.querySelector<HTMLOListElement>('.law-highlight-list');
    const direction = root.querySelector<HTMLSelectElement>('[data-law-direction]');
    const order = root.querySelector<HTMLSelectElement>('[data-law-order]');
    const more = root.querySelector<HTMLButtonElement>('[data-law-more]');
    if (!list || !direction || !order || !more) return;
    root.querySelector<HTMLElement>('[data-law-controls]')!.hidden = false;
    const items = [...list.querySelectorAll<HTMLElement>('[data-law-item]')];
    let shown = 3;
    const value = (item: HTMLElement, key: string) => Number(item.dataset[key]);
    function update(reset = true) {
      if (reset) shown = 3;
      const sorted = [...items].sort((a, b) => {
        const primary = order!.value === 'coverage' ? value(b, 'new') - value(a, 'new') : order!.value === 'recent' ? b.dataset.date!.localeCompare(a.dataset.date!) : value(b, 'affected') - value(a, 'affected');
        return primary || value(b, 'affected') - value(a, 'affected') || value(b, 'new') - value(a, 'new') || b.dataset.date!.localeCompare(a.dataset.date!) || a.dataset.id!.localeCompare(b.dataset.id!);
      });
      let count = 0;
      sorted.forEach(item => {
        const matches = !direction!.value || (direction!.value === 'mixed' ? item.dataset.direction === 'mixed' : value(item, direction!.value) > 0);
        if (matches) count++;
        item.hidden = !matches || count > shown;
        item.querySelector('[data-law-rank]')!.textContent = String(count).padStart(2, '0');
        list!.append(item);
      });
      root.querySelector('[data-law-count]')!.textContent = `${count} von ${items.length} Gesetzen${count > shown ? ` · ${shown} angezeigt` : ''}`;
      root.querySelector<HTMLElement>('[data-law-empty]')!.hidden = count !== 0;
      more!.hidden = count <= shown;
    }
    direction.addEventListener('change', () => update());
    order.addEventListener('change', () => update());
    more.addEventListener('click', () => { shown += 5; update(false); });
    root.closest('[data-party-insights]')?.querySelectorAll<HTMLAnchorElement>('[data-law-shortcut]').forEach(link => {
      link.addEventListener('click', event => {
        if (event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        direction.value = link.dataset.lawShortcut ?? '';
        update();
        direction.focus({ preventScroll: true });
        root.scrollIntoView();
      });
    });
    update();
  });
</script>
