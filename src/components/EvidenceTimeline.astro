---
import { formatDate, impactLabels } from '../lib/data';
import { formatPercentage, type PartyInsights } from '../lib/party-insights';
import type { Dataset, Impact } from '../lib/types';
interface Props { insights: PartyInsights; dataset: Dataset; year: number; active: boolean }
const { insights, dataset, year, active } = Astro.props;
const { timeline, timeline_jumps: jumps } = insights;
const id = `evidence-timeline-${year}`;
const number = (value: number) => value.toLocaleString('de-DE');
const bands: { score: Impact['score']; label: string; tone: string }[] = [
  { score: 2, label: '+2 · Setzt direkt um', tone: 'direct' },
  { score: 1, label: '+1 · Unterstützt teilweise', tone: 'partial' },
  { score: -2, label: '−2 · Widerspricht direkt', tone: 'contradicts' },
  { score: -1, label: '−1 · Erschwert', tone: 'impedes' },
  { score: 0, label: '0 · Gemischte Wirkung', tone: 'mixed' },
];
const first = timeline[0];
const last = timeline.at(-1);
const scores = last?.evidence_by_score;
const maximum = Math.max(1, (scores?.[1] ?? 0) + (scores?.[2] ?? 0), (scores?.[-1] ?? 0) + (scores?.[-2] ?? 0));
const magnitude = 10 ** Math.floor(Math.log10(maximum));
const ceiling = Math.ceil(maximum / magnitude / 2) * magnitude * 2;
const timestamp = (date: string) => new Date(`${date}T00:00:00Z`).getTime();
const start = first ? timestamp(first.date) : 0;
const duration = last ? timestamp(last.date) - start || 1 : 1;
const x = (date: string) => 8 + (timestamp(date) - start) / duration * 584;
type Point = PartyInsights['timeline'][number];
// A single zero baseline: counts rise above it for positive effects and fall
// below it for negative effects. The signs indicate direction, not net scores.
const zeroY = 213;
const negativeY = (value: number) => zeroY + value / ceiling * 105;
const positiveY = (value: number) => zeroY - value / ceiling * 105;
// Same-day (or nearby) top laws must retain individually accessible markers.
const markerRows: number[] = [];
jumps.forEach((point, index) => {
  const occupied = jumps.slice(0, index).flatMap((other, i) => Math.abs(x(other.date) - x(point.date)) < 40 ? [markerRows[i]] : []);
  markerRows.push([0, 1, 2].find(row => !occupied.includes(row)) ?? 0);
});
type DirectionalScore = Exclude<Impact['score'], 0>;
const bounds = (point: Point, score: DirectionalScore): [number, number] => {
  const counts = point.evidence_by_score;
  const y = score > 0 ? positiveY : negativeY;
  const inner = Math.abs(score) === 2 ? 0 : counts[score > 0 ? 2 : -2];
  return [y(inner), y(inner + counts[score])];
};
// Two step boundaries in opposite directions form a real stacked area. Reverse
// traversal keeps every exact-date jump at the same x-coordinate on both boundaries.
// Flat spans retain the last known count; do not invent gradual evidence arrivals.
const area = (score: DirectionalScore) => {
  const upper = timeline.map(point => [x(point.date), bounds(point, score)[1]]);
  const lower = timeline.map(point => [x(point.date), bounds(point, score)[0]]);
  const forward = upper.map(([px, py], index) => `${index ? 'H' : 'M'}${px.toFixed(2)}${index ? 'V' : ' '}${py.toFixed(2)}`).join(' ');
  const backward = [...lower].reverse().map(([px, py], index) => `${index ? 'V' : 'L'}${index ? py.toFixed(2) : `${px.toFixed(2)} ${py.toFixed(2)}`}${index ? `H${px.toFixed(2)}` : ''}`).join(' ');
  return `${forward} ${backward} Z`;
};
const dateLabels = first && last ? [...new Set([first.date,
  new Date(start + duration / 2).toISOString().slice(0, 10), last.date])] : [];
const lawById = new Map(insights.law_effects.map(law => [law.id, law]));
---
<section class="insight-card timeline-card" data-period-anchor="zeitverlauf" id={active ? 'zeitverlauf' : undefined} aria-labelledby={`${id}-heading`}>
  <div class="insight-card-heading"><div><div class="eyebrow">Entwicklung & Gesetzeswirkungen</div><h2 id={`${id}-heading`}>Belege über Zeit</h2></div><span class="insight-unit">{number(insights.laws.total)} Gesetze · {number(insights.laws.evidence)} Belege</span></div>
  <p class="insight-description">Eine gemeinsame Nulllinie: Unterstützung wächst nach oben, Gegenwirkung nach unten. Direkte und teilweise Wirkungen bleiben getrennt. Der Verlauf zeigt jedes Veröffentlichungsdatum, ohne Monatsgruppen.</p>
  {timeline.length > 0 ? <>
    <div class="timeline-headline"><strong>{number(insights.laws.evidence)} Belege</strong><span>{number(insights.criteria.covered)} von {number(insights.criteria.total)} Kriterien belegt · {formatPercentage(insights.coverage_percent)} Abdeckung</span></div>
    <figure class="evidence-chart">
      <div class="chart-unit">Kumulierte Belege, nicht Bewertungspunkte · gemeinsame Nulllinie und gleiche Skala in beide Richtungen</div>
      <div class="chart-scroll" tabindex="0" aria-label="Zeitdiagramm, auf kleinen Bildschirmen horizontal scrollbar">
        <div class="chart-surface">
          <div class="chart-direction chart-negative-label">Gegenwirkung ↓ · Anzahl Belege</div>
          <div class="chart-direction chart-positive-label">Unterstützung ↑ · Anzahl Belege</div>
          <div class="chart-layout">
            <div class="chart-y-labels" aria-hidden="true">
              <span data-zero-label style={`top:${zeroY}px`}>0</span>
              {[ceiling / 2, ceiling].map(value => <span style={`top:${negativeY(value)}px`}>−{number(value)}</span>)}
              {[ceiling, ceiling / 2].map(value => <span style={`top:${positiveY(value)}px`}>+{number(value)}</span>)}
            </div>
            <div class="chart-plot">
              <svg viewBox="0 0 600 350" preserveAspectRatio="none" role="img" aria-labelledby={`${id}-title`} aria-describedby={`${id}-description`}>
                <title id={`${id}-title`}>Gestapelte Gesetzesbelege nach Wirkung für Programm {year}</title>
                <desc id={`${id}-description`}>Heutige akzeptierte Belege, kumuliert an den exakten Veröffentlichungsdaten der Gesetze auf einer durchgehenden Zeitachse. +2 setzt direkt um, +1 unterstützt teilweise, −2 widerspricht direkt, −1 erschwert, 0 ist gemischt. Unterstützung wächst über der gemeinsamen Nulllinie, Gegenwirkung darunter; beide nutzen dieselbe Anzahlskala. Gemischte Belege (0) zählen zur Gesamtzahl und stehen in Legende und Datentabelle, werden aber nicht als Unterstützung oder Gegenwirkung dargestellt. Keine historische Umsetzungsquote. Die drei markierten Einzelgesetze haben die meisten Belege. Datumswerte und Gesetze stehen unter dem Diagramm.</desc>
                {[0, ceiling / 2, ceiling].flatMap(value => [negativeY(value), positiveY(value)]).map(y => <line x1="8" x2="592" y1={y} y2={y} class="chart-grid-line" vector-effect="non-scaling-stroke" />)}
                {bands.map(band => band.score !== 0 && <path d={area(band.score)} class={`chart-score chart-score-${band.tone}`} data-score={band.score} />)}
                <line x1="8" x2="592" y1={zeroY} y2={zeroY} class="chart-baseline chart-zero-baseline" vector-effect="non-scaling-stroke" />
                {jumps.map(point => <line x1={x(point.date)} x2={x(point.date)} y1="28" y2={negativeY(ceiling)} class="chart-jump-line" vector-effect="non-scaling-stroke" />)}
              </svg>
              {jumps.map((point, index) => <a class="chart-jump-marker" data-jump-marker href={`#${id}-jump-${index + 1}`} style={`left:${x(point.date) / 6}%;top:${markerRows[index] * 30}px`} aria-label={`Gesetz auf Rang ${index + 1}: ${lawById.get(point.law_ids[0])!.title}, ${formatDate(point.date)}, ${number(point.new_evidence)} neue Belege. Gesetz und Quellen ansehen.`} title={`${lawById.get(point.law_ids[0])!.title} · ${formatDate(point.date)} · ${number(point.new_evidence)} neue Belege`}>{index + 1}</a>)}
            </div>
          </div>
          <div class="chart-date-labels" aria-hidden="true">{dateLabels.map(date => <span>{formatDate(date)}</span>)}</div>
        </div>
      </div>
      <div class="chart-legend">{bands.map(band => <span><i class={`chart-score-${band.tone}`} />{band.label}<strong>{number(scores?.[band.score] ?? 0)}</strong></span>)}</div>
      <figcaption>Rekonstruktion aus den heute akzeptierten Belegen nach Gesetzesdatum, <strong>keine historische Umsetzungsquote</strong>. Jeder Beleg zählt einmal, ein Kriterium kann mehrere Belege haben. Gemischte Belege (0) zählen zur Gesamtzahl, werden aber nicht als Unterstützung oder Gegenwirkung dargestellt. +2 bezeichnet die direkte Umsetzung durch ein einzelnes Gesetz, nicht automatisch die Gesamtbewertung des Kriteriums. Spätere Gegenwirkungen löschen frühere Belege nicht.</figcaption>
    </figure>
    <div class="timeline-jumps" data-period-anchor="gesetzeswirkung" id={active ? 'gesetzeswirkung' : undefined}>
      <h3>Die drei Gesetze mit dem größten Einfluss auf den Verlauf</h3>
      <p class="insight-description">Rang 1–3 nach Anzahl akzeptierter Belege je einzelnem Gesetz, unabhängig von der Richtung. Keine Monats- oder Tagesgruppen. Marker öffnen genau ein Gesetz mit seinen Belegen und Quellen.</p>
      <div class="timeline-jump-list">{jumps.map((point, index) => <details class="timeline-jump" id={`${id}-jump-${index + 1}`} data-timeline-jump data-date={point.date}>
        <summary><span class="jump-number">{index + 1}</span><span><strong>{lawById.get(point.law_ids[0])!.title}</strong><small>{formatDate(point.date)} · {number(lawById.get(point.law_ids[0])!.affected)} betroffene Kriterien</small></span><strong class="jump-count">+{number(point.new_evidence)}<small>Belege</small></strong></summary>
        <ul class="jump-laws">{point.law_ids.map(lawId => { const law = lawById.get(lawId)!; return <li data-jump-law={law.id}>
          <div class="jump-law-meta"><time datetime={law.published_at}>{formatDate(law.published_at)}</time> · {law.citation}</div>
          <h4><a href={`/${dataset}/gesetze/${law.id}/`}>{law.title} ↗</a></h4>
          <p class="jump-law-counts">{number(law.affected)} betroffene Kriterien · {number(law.supporting)} unterstützt · {number(law.opposing)} mit Gegenwirkung · {number(law.mixed)} gemischt</p>
          <p class="jump-law-counts">{number(law.newly_covered)} alleinige Erstbelege ({formatPercentage(law.coverage_points).replace(' %', '')} PP Abdeckung){law.shared_newly_covered > 0 && <> · {number(law.shared_newly_covered)} gemeinsame Erstbelege am selben Tag</>}</p>
          <details class="insight-details jump-evidence"><summary>{number(law.evidence.length)} Belege & betroffene Kriterien</summary><ul class="law-criterion-evidence">{law.evidence.map(evidence => <li>
            <a href={`/${dataset}/kriterien/${evidence.criterion_id}/#${evidence.impact_id}`}>{evidence.criterion_title}</a>
            <span class="law-evidence-effect">{evidence.score > 0 ? '+' : ''}{evidence.score} · {impactLabels[evidence.score]}</span>
            <p>{evidence.rationale}</p>
            <a class="text-link" href={`/${dataset}/gesetze/${law.id}/#${evidence.impact_id}`}>Gesetz & Originalbeleg ↗</a>
          </li>)}</ul></details>
        </li>; })}</ul>
      </details>)}</div>
      <p class="insight-footnote">Erstbelege messen Belegabdeckung, nicht Umsetzung. Gemeinsame Erstbelege am selben Tag werden keinem Gesetz allein zugerechnet. Die Rangfolge zählt alle akzeptierten Belege je Einzelgesetz, nicht nur Erstbelege.</p>
    </div>
    <details class="insight-details timeline-values"><summary>Alle Veröffentlichungsdaten und zugehörigen Gesetze</summary><div class="table-scroll"><table class="data-table timeline-table">
      <caption class="sr-only">Kumulierte Anzahl akzeptierter Belege je Wirkung. Abdeckung zählt jedes Kriterium nur einmal.</caption>
      <thead><tr><th scope="col">Stand</th><th scope="col" class="num">Neue Belege</th><th scope="col" class="num">+2</th><th scope="col" class="num">+1</th><th scope="col" class="num">−2</th><th scope="col" class="num">−1</th><th scope="col" class="num">0</th><th scope="col" class="num">Belegte Kriterien</th><th scope="col" class="num">Abdeckung</th><th scope="col">Gesetze mit Belegen</th></tr></thead>
      <tbody>{timeline.map(point => <tr><th scope="row">{point.baseline ? 'Vor Vergleichsbeginn' : formatDate(point.date)}</th><td class="num">{number(point.new_evidence)}</td>{bands.map(band => <td class="num">{number(point.evidence_by_score[band.score])}</td>)}<td class="num">{number(point.covered)}</td><td class="num">{formatPercentage(point.coverage_percent)}</td><td>{point.law_ids.length ? point.law_ids.map(lawId => { const law = lawById.get(lawId)!; return <a href={`/${dataset}/gesetze/${lawId}/`} aria-label={law.title}>{law.citation || law.id}</a>; }) : '—'}</td></tr>)}</tbody>
    </table></div></details>
  </> : <div class="insight-empty" data-period-anchor="gesetzeswirkung" id={active ? 'gesetzeswirkung' : undefined}><p><strong>Noch kein belegbarer Verlauf</strong></p><p>Sobald akzeptierte Gesetzesbelege vorliegen, erscheint hier ihre zeitliche Entwicklung. Fehlende Belege bedeuten nicht, dass nichts umgesetzt wurde.</p></div>}
</section>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-jump-marker]').forEach(marker => {
    marker.addEventListener('click', event => {
      if (event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const target = document.getElementById(marker.hash.slice(1));
      if (!(target instanceof HTMLDetailsElement)) return;
      event.preventDefault();
      target.open = true;
      history.pushState(null, '', marker.hash);
      target.scrollIntoView({ block: 'start' });
      target.querySelector('summary')?.focus({ preventScroll: true });
    });
  });
  function openLinkedJump() {
    const target = document.getElementById(location.hash.slice(1));
    if (target instanceof HTMLDetailsElement && target.hasAttribute('data-timeline-jump')) target.open = true;
  }
  openLinkedJump();
  window.addEventListener('hashchange', openLinkedJump);
</script>
