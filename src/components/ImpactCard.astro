---
import Icon from './Icon.astro';
import ImpactScale from './ImpactScale.astro';
import { impactLabels, editUrl, formatDate } from '../lib/data';
import type { Impact, Data } from '../lib/types';
import { readingPageHref } from '../lib/document-anchors';
interface Props { impact: Impact; data: Data; direction?: 'law' | 'criterion' }
const { impact: i, data, direction = 'law' } = Astro.props;
const law = data.laws.find(l => l.id === i.law_id)!;
const passage = law.passages.find(p => p.id === i.law_passage_id)!;
const criterion = data.criteria.find(c => c.id === i.criterion_id)!;
const party = data.parties.find(p => p.id === criterion.party_id)!;
const href = direction === 'law' ? `/${data.dataset}/gesetze/${law.id}/` : `/${data.dataset}/kriterien/${criterion.id}/`;
---
<article class="evidence-box" id={i.id} data-verification={i.verification} data-review-status={i.review.status}>
  <div class="impact-heading"><div><div class="eyebrow">{direction === 'law' ? formatDate(law.published_at) : party.short_name}</div><h3><a href={href}>{direction === 'law' ? law.title : criterion.title} <Icon name="arrow" size={13} /></a></h3></div><span class="impact-number">{i.score > 0 ? '+' : ''}{i.score}</span></div>
  <div class="activity-top"><span>{impactLabels[i.score]}</span></div>
  <ImpactScale score={i.score} />
  <p>{i.rationale}</p>
  <blockquote>{i.law_quote}</blockquote>
  <div class="evidence-footer"><a class="text-link" href={readingPageHref('laws', law.id, passage.reference.page)}><Icon name="file" size={12} /> Gesetzespassage ansehen</a><a class="text-link" href={editUrl(data.dataset, 'impacts', i.id)}>Verknüpfung korrigieren <Icon name="github" size={13} /></a></div>
</article>
<style>
  .evidence-box { scroll-margin-top: 110px; }
  .evidence-box:target { outline: 2px solid #9fb9f4; }
</style>
