---
import Icon from './Icon.astro';
import ProgramPassage from './ProgramPassage.astro';
import { readingChapters } from '../lib/program-reader';
import type { Program, Criterion } from '../lib/types';
import '../styles/program.css';
interface Props { program: Program; criteria: Criterion[] }
const { program, criteria } = Astro.props;
const chapters = readingChapters(program);
const byLeaf = new Map<string, Criterion[]>();
for (const criterion of criteria) byLeaf.set(criterion.leaf_id, [...(byLeaf.get(criterion.leaf_id) ?? []), criterion]);
---
<div class="program-reader" data-program-reader id={program.tree.leaf_ids.length ? undefined : program.tree.id}>
  <aside class="program-navigation-wrap">
    <details class="program-navigation" data-reader-navigation open>
      <summary><span><Icon name="file" size={17} /> Inhalt & Suche</span><Icon name="down" size={15} /></summary>
      <div class="program-navigation-body">
        <div class="reader-controls" data-reader-controls hidden>
          <label for="program-search">Im Programm suchen</label>
          <div class="reader-search"><Icon name="search" size={16} /><input id="program-search" type="search" placeholder="Begriff oder Thema …" autocomplete="off" /></div>
          <label class="reader-criteria-filter"><input type="checkbox" data-reader-only-criteria /> Nur Absätze mit Kriterien</label>
          <p class="reader-result-count" data-reader-count role="status" aria-live="polite">{program.leaves.length} Absätze</p>
          <button type="button" class="reader-reset" data-reader-reset hidden>Filter zurücksetzen</button>
        </div>
        <nav aria-label="Kapitel im Wahlprogramm">
          <ol class="program-toc">
            {chapters.map(chapter => <li><a href={`#${chapter.id}`} class:list={[{ ancillary: chapter.ancillary }]} data-reader-nav-link>
              <span>{chapter.title}{chapter.continued && <small> · Fortsetzung</small>}</span><small>S. {chapter.firstPage}</small>
            </a></li>)}
          </ol>
        </nav>
        <a class="reader-back" href={`/${program.dataset}/parteien/${program.party_id}/`}>Zur Parteiübersicht <Icon name="arrow" size={13} /></a>
      </div>
    </details>
  </aside>
  <div class="program-reading-area">
    <div class="reader-introduction"><span class="eyebrow">Programmtext</span><p>In Reihenfolge der Quelle. Zitate und Kriterien direkt am Absatz.</p></div>
    <div class="reader-empty" data-reader-empty hidden><Icon name="search" size={23} /><h2>Keine passenden Absätze</h2><p>Versuche einen anderen Begriff oder zeige wieder das ganze Programm.</p><button type="button" class="button" data-reader-reset>Alle Absätze anzeigen</button></div>
    {chapters.map(chapter => <details class:list={['program-chapter', { ancillary: chapter.ancillary }]} id={chapter.id} open={!chapter.ancillary} data-reader-chapter>
      <summary>
        <div><h2>{chapter.title}{chapter.continued && <small> · Fortsetzung</small>}</h2><span class="chapter-meta">PDF-Seite {chapter.firstPage}{chapter.lastPage !== chapter.firstPage && `–${chapter.lastPage}`} · {chapter.leafIds.length} {chapter.leafIds.length === 1 ? 'Absatz' : 'Absätze'}</span></div>
        <Icon name="down" size={20} />
      </summary>
      <div class="program-chapter-body">
        {chapter.blocks.map(block => {
          if (block.kind === 'passage') return <ProgramPassage leaf={block.leaf} program={program} criteria={byLeaf.get(block.leaf.id) ?? []} number={block.number} sections={block.sections} />;
          const Heading = `h${block.level}` as 'h3' | 'h4' | 'h5' | 'h6';
          return <Heading class="program-section-heading" id={block.id} data-reader-heading data-leaf-ids={block.leafIds.join(' ')}>{block.title}{block.continued && <small> · Fortsetzung</small>}</Heading>;
        })}
      </div>
    </details>)}
    <div class="reader-end"><Icon name="file" size={18} /><span>Ende der Textspur · {program.leaves.length} Absätze erhalten.</span><a href="#content">Nach oben ↑</a></div>
  </div>
</div>
<script>
  import { searchText } from '../lib/program-reader-search';
  const reader = document.querySelector<HTMLElement>('[data-program-reader]');
  if (reader) {
    const input = reader.querySelector<HTMLInputElement>('#program-search')!;
    const onlyCriteria = reader.querySelector<HTMLInputElement>('[data-reader-only-criteria]')!;
    const passages = [...reader.querySelectorAll<HTMLElement>('[data-reader-passage]')];
    const chapters = [...reader.querySelectorAll<HTMLDetailsElement>('[data-reader-chapter]')];
    const headings = [...reader.querySelectorAll<HTMLElement>('[data-reader-heading]')];
    const navigation = reader.querySelector<HTMLDetailsElement>('[data-reader-navigation]')!;
    const navLinks = [...reader.querySelectorAll<HTMLAnchorElement>('[data-reader-nav-link]')];
    const count = reader.querySelector<HTMLElement>('[data-reader-count]')!;
    const empty = reader.querySelector<HTMLElement>('[data-reader-empty]')!;
    const controls = reader.querySelector<HTMLElement>('[data-reader-controls]')!;
    const reset = reader.querySelector<HTMLButtonElement>('.reader-reset')!;
    const openBeforeFilter = new Map<HTMLDetailsElement, boolean>();
    const disclosures = [...chapters, ...reader.querySelectorAll<HTMLDetailsElement>('[data-reader-layout]')];
    const mobile = matchMedia('(max-width: 900px)');
    navigation.open = !mobile.matches;
    mobile.addEventListener('change', () => { navigation.open = !mobile.matches; });
    controls.hidden = false;

    function syncUrl() {
      const url = new URL(location.href);
      if (input.value) url.searchParams.set('q', input.value); else url.searchParams.delete('q');
      if (onlyCriteria.checked) url.searchParams.set('criteria', '1'); else url.searchParams.delete('criteria');
      history.replaceState(null, '', url);
    }
    function filter(updateUrl = true) {
      const terms = searchText(input.value).split(' ').filter(Boolean);
      const active = terms.length > 0 || onlyCriteria.checked;
      if (active && !openBeforeFilter.size) for (const disclosure of disclosures) openBeforeFilter.set(disclosure, disclosure.open);
      const visible = new Set<string>();
      for (const passage of passages) {
        passage.hidden = !terms.every(term => passage.dataset.search!.includes(term))
          || (onlyCriteria.checked && passage.dataset.hasCriteria !== 'true');
        if (!passage.hidden) visible.add(passage.id);
      }
      for (const heading of headings) heading.hidden = !heading.dataset.leafIds!.split(' ').some(id => visible.has(id));
      for (const chapter of chapters) {
        chapter.hidden = ![...chapter.querySelectorAll<HTMLElement>('[data-reader-passage]')].some(p => visible.has(p.id));
        if (active && !chapter.hidden) chapter.open = true;
      }
      for (const disclosure of disclosures) {
        if (active && !disclosure.closest('[hidden]')) disclosure.open = true;
        if (!active && openBeforeFilter.has(disclosure)) disclosure.open = openBeforeFilter.get(disclosure)!;
      }
      if (!active) openBeforeFilter.clear();
      for (const link of navLinks) {
        const chapter = document.getElementById(link.hash.slice(1))!;
        link.parentElement!.hidden = chapter.hidden;
      }
      count.textContent = `${visible.size} von ${passages.length} Absätzen${active ? ' angezeigt' : ''}`;
      empty.hidden = visible.size > 0;
      reset.hidden = !active;
      if (updateUrl) syncUrl();
    }
    function clearFilters() { input.value = ''; onlyCriteria.checked = false; filter(); }
    function restoreFilters() {
      const query = new URL(location.href).searchParams;
      input.value = query.get('q') ?? '';
      onlyCriteria.checked = query.get('criteria') === '1';
      filter(false);
    }
    input.addEventListener('input', () => filter());
    input.addEventListener('keydown', event => { if (event.key === 'Escape') clearFilters(); });
    onlyCriteria.addEventListener('change', () => filter());
    for (const button of reader.querySelectorAll<HTMLButtonElement>('[data-reader-reset]')) button.addEventListener('click', clearFilters);
    restoreFilters();

    // A source deep link always wins over a conflicting search filter. Open only
    // its ancestors, preserve the existing ID and keep it below the fixed header.
    function reveal() {
      let anchor: string;
      try { anchor = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      const target = document.getElementById(anchor);
      if (!target || !reader!.contains(target)) return;
      if (target.closest('[hidden]')) clearFilters();
      const layout = target.closest('[data-reader-passage]')?.querySelector<HTMLDetailsElement>('[data-reader-layout]');
      if (layout) layout.open = true;
      let element: HTMLElement | null = target;
      while (element && element !== reader) {
        if (element instanceof HTMLDetailsElement) element.open = true;
        element = element.parentElement;
      }
      if (mobile.matches) navigation.open = false;
      const hash = location.hash;
      requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
      // Local webfonts can still settle after fragment navigation on a cold load.
      void document.fonts.ready.then(() => { if (location.hash === hash) target.scrollIntoView({ block: 'start' }); });
    }
    reveal();
    window.addEventListener('hashchange', reveal);
    window.addEventListener('popstate', () => { restoreFilters(); reveal(); });
    // Re-selecting an existing fragment does not generate hashchange.
    for (const link of navLinks) link.addEventListener('click', () => { if (link.hash === location.hash) reveal(); });

    const observer = new IntersectionObserver(entries => {
      const current = entries.filter(entry => entry.isIntersecting && !(entry.target as HTMLElement).hidden)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top).at(-1);
      if (!current) return;
      for (const link of navLinks) {
        if (link.hash === `#${current.target.id}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    }, { rootMargin: '-110px 0px -55% 0px', threshold: 0 });
    for (const chapter of chapters) observer.observe(chapter);
    const beforePrint = new Map<HTMLDetailsElement, boolean>();
    const hiddenBeforePrint = new Map<HTMLElement, boolean>();
    window.addEventListener('beforeprint', () => {
      // Print the whole programme even when search has hidden passages. Restore
      // the reader afterwards without changing its filters or shareable URL.
      if (beforePrint.size || hiddenBeforePrint.size) return;
      for (const element of [...passages, ...chapters, ...headings, empty]) hiddenBeforePrint.set(element, element.hidden);
      for (const element of [...passages, ...chapters, ...headings]) element.hidden = false;
      empty.hidden = true;
      for (const disclosure of disclosures) { beforePrint.set(disclosure, disclosure.open); disclosure.open = true; }
    });
    window.addEventListener('afterprint', () => {
      for (const [disclosure, open] of beforePrint) disclosure.open = open;
      for (const [element, hidden] of hiddenBeforePrint) element.hidden = hidden;
      beforePrint.clear();
      hiddenBeforePrint.clear();
    });
  }
</script>
