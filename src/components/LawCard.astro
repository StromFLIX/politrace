---
import Icon from './Icon.astro';
import { topics, formatDate } from '../lib/data';
import { voteTotals } from '../lib/metrics';
import type { Law, Data } from '../lib/types';
interface Props { law: Law; data: Data }
const { law, data } = Astro.props;
const impacts = data.impacts.filter(i => i.law_id === law.id && i.review.status !== 'rejected');
const affectedParties = [...new Set(impacts.map(i => data.criteria.find(c => c.id === i.criterion_id)!.party_id))];
const vote = data.votes.find(v => v.law_id === law.id && v.review.status === 'reviewed');
const totals = vote && voteTotals(vote.groups);
---
<article class="activity-card" data-filter-item data-search={`${law.title} ${law.summary} ${law.citation} ${law.tags.map(t => topics[t]).join(' ')}`} data-party={affectedParties.join(' ')} data-topic={law.tags.join(' ')} data-status={impacts.length ? 'linked' : 'pending'}>
  <div class="activity-card-main"><div class="activity-top"><span><Icon name="clock" size={12} /> {formatDate(law.published_at)}</span><span class="status reviewed">{data.dataset === 'demo' ? 'Beispielgesetz' : 'Verkündet'}</span>{law.tags.map(t => <span class="tag">{topics[t]}</span>)}</div><h2><a href={`/${data.dataset}/gesetze/${law.id}/`}>{law.title}</a></h2><p>{law.summary}</p><div class="activity-impact-row">{impacts.map(i => { const c = data.criteria.find(c => c.id === i.criterion_id)!; const p = data.parties.find(p => p.id === c.party_id)!; return <a href={`/${data.dataset}/kriterien/${c.id}/#${i.id}`} class:list={['impact-pill', { negative: i.score < 0 }]} title={`${c.title} · ${i.review.status === 'reviewed' ? 'geprüft' : 'Vorschlag'}`}><Icon name="link" size={11} />{p.short_name} <strong>{i.score > 0 ? '+' : ''}{i.score}</strong>{i.review.status !== 'reviewed' && ' · Vorschlag'}</a>; })}{!impacts.length && <span class="subtle-link"><Icon name="link" size={13} /> Noch keine belegte Verknüpfung</span>}</div></div>
  <div class="activity-card-footer">{totals ? <span class="votes-preview"><span class="mini-vote-bar" aria-hidden="true"><span class="vote-yes" style={`flex:${totals.yes}`} /><span class="vote-no" style={`flex:${totals.no}`} /><span class="vote-abstain" style={`flex:${totals.abstain}`} /></span><span>{totals.yes} Ja · {totals.no} Nein {data.dataset === 'demo' && '(fiktiv)'}</span></span> : <span><Icon name="info" size={12} /> Abstimmungsnachweis noch offen</span>}<a href={`/${data.dataset}/gesetze/${law.id}/`} class="text-link">Gesetz & Belege <Icon name="arrow" size={13} /></a></div>
</article>
