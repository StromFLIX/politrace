---
import Icon from './Icon.astro';
import { extractionCoverage } from '../lib/metrics';
import type { Program, Criterion } from '../lib/types';
interface Props { program: Program; criteria: Criterion[] }
const { program, criteria } = Astro.props;
const coverage = extractionCoverage(program, criteria);
---
{program.dataset === 'live' && <div class="notice" data-extraction-status>
  <Icon name="info" size={17} />
  <span><strong>{coverage.complete ? 'Kriterien-Extraktion durchlaufen' : 'Teilauswertung / Pilotdaten'}</strong><br />
    {coverage.processed_leaves} von {coverage.source_leaves} Absätzen für Kriterien ausgewertet.
    {coverage.remaining_leaves > 0 && ` ${coverage.remaining_leaves} Absätze sind noch nicht ausgewertet.`}
    {' '}Das zählt bearbeitete Absätze, nicht nachgewiesene Vollständigkeit oder redaktionelle Prüfung.
    <a class="text-link" href="/api/v1/live/extraction.json">Bearbeitungsstand als JSON</a>
  </span>
</div>}
