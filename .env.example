# Pipelines ONLY. Never expose this as a PUBLIC_/VITE_ variable or Docker build arg.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_REVIEW_MODEL=openai/gpt-5.6-sol
POLITRACE_MAX_USD=5
POLITRACE_MAX_CALLS=200
# Only affects the default landing page; both /demo/ and /live/ always exist.
POLITRACE_DATASET=auto
PORT=8080
